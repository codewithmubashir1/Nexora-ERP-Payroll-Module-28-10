@{
    ViewData["Title"] = "Users & Roles";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">All Users</h3>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#importUserModal">
                <i class="fa-solid fa-file-import me-1"></i> Import
            </button>
            <a asp-controller="Users" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-user-plus me-1"></i> New User
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="usersTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th></th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

<partial name="_ImportModal" model='new ERP.Identity.Models.ViewModels.ImportModalViewModel {
    Id = "importUserModal", Title = "Import Users",
    ActionUrl = Url.Action("Import", "Users"),
    TemplateUrl = Url.Action("Template", "Users"),
    Description = "Create or update user accounts in bulk. Matches existing users by Email. If Password is left blank for a new user, a temporary password is generated — share it with the user securely and have them change it on first login."
}' />

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function badgeForRole(role) {
            const map = {
                'Admin': 'bg-danger', 'Supervisor': 'bg-primary', 'Manager': 'bg-info',
                'Standard User': 'bg-secondary', 'Accountant': 'bg-success', 'Store Incharge': 'bg-warning'
            };
            return `<span class="badge ${map[role] || 'bg-dark'}">${role}</span>`;
        }

        jQuery(function () {
            const table = jQuery('#usersTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "Users")', dataSrc: 'data' },
                responsive: true,
                pageLength: 10,
                columns: [
                    {
                        data: 'profileImagePath', orderable: false,
                        render: function (data) {
                            const src = data ? data : '/images/default-avatar.svg';
                            return `<img src="${src}" class="table-avatar" />`;
                        }
                    },
                    { data: 'fullName' },
                    { data: 'email' },
                    { data: 'phoneNumber', render: d => d || '—' },
                    { data: 'department', render: d => d || '—' },
                    { data: 'role', render: d => badgeForRole(d) },
                    {
                        data: 'isActive',
                        render: function (data, type, row) {
                            const cls = data ? 'bg-success' : 'bg-secondary';
                            const label = data ? 'Active' : 'Inactive';
                            return `<span class="badge ${cls} toggle-status" style="cursor:pointer" data-id="${row.id}">${label}</span>`;
                        }
                    },
                    {
                        data: 'id', orderable: false,
                        render: function (id) {
                            return `
                                <div class="text-end">
                                    <a href="/Users/Edit/${id}" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-user" data-id="${id}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>`;
                        }
                    }
                ]
            });

            jQuery('#usersTable tbody').on('click', '.btn-delete-user', function () {
                const id = jQuery(this).data('id');
                confirmDelete('@Url.Action("Delete", "Users")', token, function () { table.ajax.reload(); }, { id: id });
            });

            jQuery('#usersTable tbody').on('click', '.toggle-status', function () {
                const id = jQuery(this).data('id');
                fetch('@Url.Action("ToggleActive", "Users")', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(id)
                }).then(r => r.json()).then(data => {
                    if (data.success) { notyf.success('Status updated.'); table.ajax.reload(); }
                    else notyf.error(data.message || 'Failed to update status.');
                });
            });

            document.addEventListener('erp:import-success', function () { table.ajax.reload(); });
        });
    </script>
}
