@{
    ViewData["Title"] = "Goods Receipt Notes";
    var canApprove = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Store Incharge");
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Goods Receipt Notes</h3>
        <a asp-controller="GoodsReceiptNotes" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i> New GRN
        </a>
    </div>
    <div class="card-body">
        <table id="grnTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>GRN No.</th>
                    <th>Date</th>
                    <th>Vendor</th>
                    <th>Location</th>
                    <th># Items</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const canApprove = @Json.Serialize(canApprove);

        jQuery(function () {
            const table = jQuery('#grnTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "GoodsReceiptNotes")', dataSrc: 'data' },
                order: [[0, 'desc']],
                columns: [
                    { data: 'grnNumber' },
                    { data: 'grnDate', render: d => new Date(d).toLocaleDateString('en-PK') },
                    { data: 'vendorName' },
                    { data: 'locationName' },
                    { data: 'itemCount' },
                    { data: 'status', render: d => statusBadge(d) },
                    {
                        data: null, orderable: false,
                        render: function (row) {
                            let btns = `<a href="/Purchase/GRN/View/${row.id}" class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a> <a href="/Purchase/GRN/Print/${row.id}" target="_blank" class="btn btn-sm btn-outline-dark" title="Print / Export"><i class="fa-solid fa-print"></i></a>`;
                            if (canApprove && row.status === 'Pending') {
                                btns += ` <button type="button" class="btn btn-sm btn-outline-success btn-approve" data-id="${row.id}" title="Approve"><i class="fa-solid fa-check"></i></button>`;
                                btns += ` <button type="button" class="btn btn-sm btn-outline-danger btn-reject" data-id="${row.id}" title="Reject"><i class="fa-solid fa-xmark"></i></button>`;
                            }
                            return `<div class="text-end">${btns}</div>`;
                        }
                    }
                ]
            });

            jQuery('#grnTable tbody').on('click', '.btn-approve', function () {
                approveVoucher('@Url.Action("Approve", "GoodsReceiptNotes")', jQuery(this).data('id'), token, function () { table.ajax.reload(); });
            });
            jQuery('#grnTable tbody').on('click', '.btn-reject', function () {
                rejectVoucher('@Url.Action("Reject", "GoodsReceiptNotes")', jQuery(this).data('id'), token, function () { table.ajax.reload(); });
            });
        });
    </script>
}
