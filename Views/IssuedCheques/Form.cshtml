@model ERP.Identity.Models.ViewModels.Purchase.IssuedChequeViewModel
@{
    ViewData["Title"] = "New Issued Cheque";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-controller="IssuedCheques" asp-action="Save" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Cheque Details</h3></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="VendorId" class="form-label"></label>
                            <select asp-for="VendorId" class="form-select select2" data-placeholder="Select vendor">
                                <option></option>
                                @foreach (var v in Model.Vendors) { <option value="@v.Id">@v.Name (@v.VendorCode)</option> }
                            </select>
                            <span asp-validation-for="VendorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ChequeDate" class="form-label"></label>
                            <input asp-for="ChequeDate" class="form-control datepicker" autocomplete="off" value="@Model.ChequeDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ChequeNumber" class="form-label"></label>
                            <input asp-for="ChequeNumber" class="form-control" />
                            <span asp-validation-for="ChequeNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankName" class="form-label"></label>
                            <input asp-for="BankName" class="form-control" />
                            <span asp-validation-for="BankName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Remarks" class="form-label"></label>
                            <input asp-for="Remarks" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="IssuedCheques" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Submit for Approval</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
