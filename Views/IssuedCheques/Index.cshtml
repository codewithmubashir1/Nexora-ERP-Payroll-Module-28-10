@{
    ViewData["Title"] = "Issued Cheque Management";
    var canApprove = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Accountant");
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Issued Cheques</h3>
        <a asp-controller="IssuedCheques" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i> New Cheque
        </a>
    </div>
    <div class="card-body">
        <table id="chqTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Reference No.</th>
                    <th>Cheque No.</th>
                    <th>Bank</th>
                    <th>Date</th>
                    <th>Vendor</th>
                    <th>Amount</th>
                    <th>Clearance</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const canApprove = @Json.Serialize(canApprove);

        function clearanceBadge(status) {
            const map = { Outstanding: 'bg-warning', Cleared: 'bg-success', Bounced: 'bg-danger', Cancelled: 'bg-secondary' };
            return `<span class="badge ${map[status] || 'bg-secondary'}">${status}</span>`;
        }

        jQuery(function () {
            const table = jQuery('#chqTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "IssuedCheques")', dataSrc: 'data' },
                order: [[0, 'desc']],
                columns: [
                    { data: 'chequeReferenceNo' },
                    { data: 'chequeNumber' },
                    { data: 'bankName' },
                    { data: 'chequeDate', render: d => new Date(d).toLocaleDateString('en-PK') },
                    { data: 'vendorName' },
                    { data: 'amount', render: d => Number(d).toFixed(2) },
                    { data: 'clearanceStatus', render: d => clearanceBadge(d) },
                    { data: 'status', render: d => statusBadge(d) },
                    {
                        data: null, orderable: false,
                        render: function (row) {
                            let btns = `<a href="/Purchase/Cheques/Print/${row.id}" target="_blank" class="btn btn-sm btn-outline-dark" title="Print / Export"><i class="fa-solid fa-print"></i></a> `;
                            if (canApprove && row.status === 'Pending') {
                                btns += `<button type="button" class="btn btn-sm btn-outline-success btn-approve" data-id="${row.id}" title="Approve"><i class="fa-solid fa-check"></i></button> `;
                                btns += `<button type="button" class="btn btn-sm btn-outline-danger btn-reject" data-id="${row.id}" title="Reject"><i class="fa-solid fa-xmark"></i></button> `;
                            }
                            if (canApprove && row.status === 'Approved' && row.clearanceStatus === 'Outstanding') {
                                btns += `<button type="button" class="btn btn-sm btn-outline-primary btn-clear" data-id="${row.id}" title="Mark Cleared"><i class="fa-solid fa-circle-check"></i></button> `;
                                btns += `<button type="button" class="btn btn-sm btn-outline-warning btn-bounce" data-id="${row.id}" title="Mark Bounced"><i class="fa-solid fa-triangle-exclamation"></i></button> `;
                            }
                            if (row.status === 'Pending') {
                                btns += `<button type="button" class="btn btn-sm btn-outline-secondary btn-delete" data-id="${row.id}" title="Delete"><i class="fa-solid fa-trash"></i></button>`;
                            }
                            return `<div class="text-end">${btns}</div>`;
                        }
                    }
                ]
            });

            jQuery('#chqTable tbody').on('click', '.btn-approve', function () {
                approveVoucher('@Url.Action("Approve", "IssuedCheques")', jQuery(this).data('id'), token, function () { table.ajax.reload(); });
            });
            jQuery('#chqTable tbody').on('click', '.btn-reject', function () {
                rejectVoucher('@Url.Action("Reject", "IssuedCheques")', jQuery(this).data('id'), token, function () { table.ajax.reload(); });
            });
            jQuery('#chqTable tbody').on('click', '.btn-delete', function () {
                confirmDelete('@Url.Action("Delete", "IssuedCheques")', token, function () { table.ajax.reload(); }, { id: jQuery(this).data('id') });
            });
            jQuery('#chqTable tbody').on('click', '.btn-clear, .btn-bounce', function () {
                const status = jQuery(this).hasClass('btn-clear') ? 1 : 2;
                const id = jQuery(this).data('id');
                fetch('@Url.Action("SetClearance", "IssuedCheques")', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&status=${status}`
                }).then(r => r.json()).then(data => {
                    if (data.success) { notyf.success(data.message); table.ajax.reload(); }
                    else notyf.error(data.message);
                });
            });
        });
    </script>
}
