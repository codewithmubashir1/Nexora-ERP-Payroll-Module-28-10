@{
    ViewData["Title"] = "Customer Categories";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Customer Categories</h3>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#importCategoryModal">
                <i class="fa-solid fa-file-import me-1"></i> Import
            </button>
            <a asp-controller="CustomerCategories" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus me-1"></i> New Category
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="categoriesTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Description</th>
                    <th># Customers</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

<partial name="_ImportModal" model='new ERP.Identity.Models.ViewModels.ImportModalViewModel {
    Id = "importCategoryModal", Title = "Import Customer Categories",
    ActionUrl = Url.Action("Import", "CustomerCategories"),
    TemplateUrl = Url.Action("Template", "CustomerCategories"),
    Description = "Create or update customer categories in bulk. Matches existing categories by Name."
}' />

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        jQuery(function () {
            const table = jQuery('#categoriesTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "CustomerCategories")', dataSrc: 'data' },
                columns: [
                    { data: 'name' },
                    { data: 'code', render: d => d || '—' },
                    { data: 'description', render: d => d || '—' },
                    { data: 'customerCount' },
                    {
                        data: 'isActive',
                        render: d => d ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'
                    },
                    {
                        data: 'id', orderable: false,
                        render: id => `
                            <div class="text-end">
                                <a href="/Sales/CustomerCategories/Edit/${id}" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${id}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </div>`
                    }
                ]
            });

            jQuery('#categoriesTable tbody').on('click', '.btn-delete', function () {
                const id = jQuery(this).data('id');
                confirmDelete('@Url.Action("Delete", "CustomerCategories")', token, function () { table.ajax.reload(); }, { id: id });
            });

            document.addEventListener('erp:import-success', function () { table.ajax.reload(); });
        });
    </script>
}
