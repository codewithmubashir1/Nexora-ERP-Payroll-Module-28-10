@{
    ViewData["Title"] = "Locations";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Locations</h3>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#importLocationModal">
                <i class="fa-solid fa-file-import me-1"></i> Import
            </button>
            <a asp-controller="Locations" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus me-1"></i> New Location
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="locationsTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Address</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

<partial name="_ImportModal" model='new ERP.Identity.Models.ViewModels.ImportModalViewModel {
    Id = "importLocationModal", Title = "Import Locations",
    ActionUrl = Url.Action("Import", "Locations"),
    TemplateUrl = Url.Action("Template", "Locations"),
    Description = "Create or update warehouse/store locations in bulk. Matches existing locations by Name."
}' />

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        jQuery(function () {
            const table = jQuery('#locationsTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "Locations")', dataSrc: 'data' },
                responsive: true,
                pageLength: 10,
                columns: [
                    { data: 'name' },
                    { data: 'code', render: d => d || '—' },
                    { data: 'address', render: d => d || '—' },
                    {
                        data: 'isActive',
                        render: d => d ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'
                    },
                    {
                        data: 'id', orderable: false,
                        render: id => `
                            <div class="text-end">
                                <a href="/Inventory/Locations/Edit/${id}" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${id}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </div>`
                    }
                ]
            });

            jQuery('#locationsTable tbody').on('click', '.btn-delete', function () {
                const id = jQuery(this).data('id');
                confirmDelete('@Url.Action("Delete", "Locations")', token, function () { table.ajax.reload(); }, { id: id });
            });

            document.addEventListener('erp:import-success', function () { table.ajax.reload(); });
        });
    </script>
}
