@model ERP.Identity.Models.ViewModels.Payroll.ReimbursementRequestFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Reimbursement Request" : "New Reimbursement Request";
}

<form asp-controller="ReimbursementRequests" asp-action="Save" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingReceiptImagePath" />

    <div class="row justify-content-center">
        <div class="col-lg-4">
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Receipt</h3></div>
                <div class="card-body">
                    <partial name="_AvatarUpload" model="@Model.ExistingReceiptImagePath"
                             view-data='@(new ViewDataDictionary(ViewData) { { "InputName", "Receipt" }, { "Label", "Receipt" } })' />
                    <span asp-validation-for="Receipt" class="text-danger small d-block text-center"></span>

                    @if (!string.IsNullOrEmpty(Model.ExistingReceiptImagePath))
                    {
                        <div class="text-center mt-2">
                            <a href="@Model.ExistingReceiptImagePath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-up-right-from-square me-1"></i> Open full size
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header">
                    <h3 class="card-title">
                        Expense Details
                        @if (isEdit)
                        {
                            <span class="badge bg-primary ms-2">@Model.RequestNumber</span>
                        }
                    </h3>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EmployeeId" class="form-label"></label>
                            <select asp-for="EmployeeId" class="form-select select2" data-placeholder="Select employee">
                                <option></option>
                                @foreach (var e in Model.Employees)
                                {
                                    <option value="@e.Id" selected="@(e.Id == Model.EmployeeId)">@e.Name (@e.EmployeeCode)</option>
                                }
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReimbursementTypeId" class="form-label"></label>
                            <select asp-for="ReimbursementTypeId" id="typeSelect" class="form-select select2" data-placeholder="Select expense type">
                                <option></option>
                                @foreach (var t in Model.ReimbursementTypes)
                                {
                                    <option value="@t.Id" data-limit="@(t.MaxLimit?.ToString("0.00") ?? "")" selected="@(t.Id == Model.ReimbursementTypeId)">@t.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ReimbursementTypeId" class="text-danger small"></span>
                            <div class="form-text" id="limitHint"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpenseDate" class="form-label"></label>
                            <input asp-for="ExpenseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="What was this expense for?"></textarea>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="ReimbursementRequests" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-paper-plane me-1"></i> @(isEdit ? "Update Request" : "Submit Request")
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showLimit() {
            const sel = document.getElementById('typeSelect');
            const opt = sel.options[sel.selectedIndex];
            const limit = opt ? opt.getAttribute('data-limit') : '';

            document.getElementById('limitHint').textContent = limit
                ? 'Maximum claimable: ' + Number(limit).toLocaleString('en-PK', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                : '';
        }

        jQuery('#typeSelect').on('change', showLimit);
        showLimit();
    </script>
}
