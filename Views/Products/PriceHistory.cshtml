@model ERP.Identity.Models.Inventory.Product
@{
    ViewData["Title"] = $"Price History — {Model.Name}";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="card-title mb-0">Price History</h3>
            <small class="text-muted">@Model.Name (@Model.Sku)</small>
        </div>
        <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Products
        </a>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-3"><small class="text-muted d-block">Current Cost Price</small><strong>@Model.CostPrice.ToString("N2")</strong></div>
            <div class="col-md-3"><small class="text-muted d-block">Current Sale Price</small><strong>@Model.SalePrice.ToString("N2")</strong></div>
        </div>

        <table id="priceHistoryTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Changed On</th>
                    <th>Changed By</th>
                    <th>Old Cost</th>
                    <th>New Cost</th>
                    <th>Old Sale</th>
                    <th>New Sale</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        jQuery(function () {
            jQuery('#priceHistoryTable').DataTable({
                ajax: { url: '@Url.Action("GetPriceHistory", "Products", new { id = Model.Id })', dataSrc: 'data' },
                order: [[0, 'desc']],
                columns: [
                    { data: 'changedOn', render: d => new Date(d).toLocaleString('en-PK') },
                    { data: 'changedBy' },
                    { data: 'oldCostPrice', render: d => Number(d).toFixed(2) },
                    {
                        data: 'newCostPrice',
                        render: function (d, type, row) {
                            const cls = d > row.oldCostPrice ? 'text-danger' : (d < row.oldCostPrice ? 'text-success' : '');
                            const icon = d > row.oldCostPrice ? '<i class="fa-solid fa-arrow-up me-1"></i>' : (d < row.oldCostPrice ? '<i class="fa-solid fa-arrow-down me-1"></i>' : '');
                            return `<span class="${cls}">${icon}${Number(d).toFixed(2)}</span>`;
                        }
                    },
                    { data: 'oldSalePrice', render: d => Number(d).toFixed(2) },
                    {
                        data: 'newSalePrice',
                        render: function (d, type, row) {
                            const cls = d > row.oldSalePrice ? 'text-success' : (d < row.oldSalePrice ? 'text-danger' : '');
                            const icon = d > row.oldSalePrice ? '<i class="fa-solid fa-arrow-up me-1"></i>' : (d < row.oldSalePrice ? '<i class="fa-solid fa-arrow-down me-1"></i>' : '');
                            return `<span class="${cls}">${icon}${Number(d).toFixed(2)}</span>`;
                        }
                    }
                ]
            });
        });
    </script>
}
