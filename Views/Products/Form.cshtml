@model ERP.Identity.Models.ViewModels.Inventory.ProductFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Product" : "New Product";
}

<form asp-controller="Products" asp-action="Save" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-lg-4">
            <div class="card animate__animated animate__fadeIn">
                <div class="card-body">
                    <partial name="_AvatarUpload" model="@Model.ExistingProductImagePath" view-data='@(new ViewDataDictionary(ViewData) { { "InputName", "ProductImage" }, { "Label", "Product Photo" } })' />
                </div>
            </div>

            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Identifiers</h3></div>
                <div class="card-body">
                    @if (isEdit)
                    {
                        <div class="mb-3">
                            <label class="form-label">SKU</label>
                            <input value="@Model.Sku" class="form-control" readonly disabled />
                            <div class="form-text">System-generated, cannot be changed.</div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">SKU</label>
                            <input value="Auto-generated on save" class="form-control" readonly disabled />
                        </div>
                    }
                    <div class="mb-2">
                        <label asp-for="ProductCode" class="form-label"></label>
                        <input asp-for="ProductCode" class="form-control" placeholder="e.g. RM-STEEL-01" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="HsCode" class="form-label"></label>
                        <input asp-for="HsCode" class="form-control" placeholder="e.g. 7213.10" />
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Product Details</h3></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UnitId" class="form-label"></label>
                            <select asp-for="UnitId" class="form-select select2" data-placeholder="Select unit">
                                <option></option>
                                @foreach (var u in Model.Units)
                                {
                                    <option value="@u.Id" selected="@(u.Id == Model.UnitId)">@u.Name (@u.ShortName)</option>
                                }
                            </select>
                            <span asp-validation-for="UnitId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" class="form-select select2" data-placeholder="Select category">
                                <option></option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DefaultLocationId" class="form-label"></label>
                            <select asp-for="DefaultLocationId" class="form-select select2" data-placeholder="Select location">
                                <option></option>
                                @foreach (var l in Model.Locations)
                                {
                                    <option value="@l.Id" selected="@(l.Id == Model.DefaultLocationId)">@l.Name</option>
                                }
                            </select>
                            <div class="form-text">Where opening stock is posted and stock is tracked by default.</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CostPrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">Rs.</span>
                                <input asp-for="CostPrice" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="CostPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SalePrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">Rs.</span>
                                <input asp-for="SalePrice" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TaxRate" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="TaxRate" type="number" step="0.01" min="0" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReorderLevel" class="form-label"></label>
                            <input asp-for="ReorderLevel" type="number" step="0.001" min="0" class="form-control" />
                            <div class="form-text">Triggers a low-stock alert on the Inventory dashboard.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpeningStock" class="form-label"></label>
                            <input asp-for="OpeningStock" type="number" step="0.001" min="0" class="form-control" disabled="@isEdit" />
                            @if (isEdit)
                            {
                                <input type="hidden" asp-for="OpeningStock" />
                                <div class="form-text">Opening stock can only be set once, at creation. Use an Adjustment Note to correct stock later.</div>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label d-block">Product Type</label>
                            <div class="form-text mb-1">Controls which documents this product is offered in — a product can be more than one type.</div>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input asp-for="IsSaleable" class="form-check-input" />
                                    <label asp-for="IsSaleable" class="form-check-label">Saleable</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="IsPurchasable" class="form-check-input" />
                                    <label asp-for="IsPurchasable" class="form-check-label">Purchasable</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="IsService" class="form-check-input" />
                                    <label asp-for="IsService" class="form-check-label">Service</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="IsConsumable" class="form-check-input" />
                                    <label asp-for="IsConsumable" class="form-check-label">Consumable</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PackingUnitName" class="form-label"></label>
                            <input asp-for="PackingUnitName" class="form-control" placeholder="e.g. Box, Bin, Bag, Packet" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PackingQuantity" class="form-label"></label>
                            <input asp-for="PackingQuantity" type="number" step="0.001" min="0" class="form-control" placeholder="e.g. 24 units per Box" />
                            <div class="form-text">When set, line items show a live count of standard packages for the quantity entered.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i> @(isEdit ? "Update Product" : "Create Product")
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
