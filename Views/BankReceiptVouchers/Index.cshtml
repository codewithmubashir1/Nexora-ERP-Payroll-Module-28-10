@{
    ViewData["Title"] = "Bank Receipt Vouchers";
    var canApprove = User.IsInRole("Admin") || User.IsInRole("Accountant");
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Bank Receipt Vouchers</h3>
        <a asp-controller="BankReceiptVouchers" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i> New Bank Receipt Voucher
        </a>
    </div>
    <div class="card-body">
        <table id="voucherTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Voucher No.</th>
                    <th>Date</th>
                    <th>Account</th>
                    <th>Received From</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const canApprove = @Json.Serialize(canApprove);

        jQuery(function () {
            const table = jQuery('#voucherTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "BankReceiptVouchers")', dataSrc: 'data' },
                order: [[0, 'desc']],
                columns: [
                    { data: 'voucherNumber' },
                    { data: 'voucherDate', render: d => new Date(d).toLocaleDateString('en-PK') },
                    { data: 'contraAccountName' },
                    { data: 'partyOrNote', render: d => d || '—' },
                    { data: 'amount', render: d => Number(d).toFixed(2) },
                    { data: 'status', render: d => statusBadge(d) },
                    {
                        data: null, orderable: false,
                        render: function (row) {
                            let btns = `<a href="/Accounts/BankReceiptVouchers/Print/${row.id}" target="_blank" class="btn btn-sm btn-outline-dark" title="Print / Export"><i class="fa-solid fa-print"></i></a> `;
                            if (canApprove && row.status === 'Pending') {
                                btns += `<button type="button" class="btn btn-sm btn-outline-success btn-approve" data-id="${row.id}" title="Approve"><i class="fa-solid fa-check"></i></button> `;
                                btns += `<button type="button" class="btn btn-sm btn-outline-danger btn-reject" data-id="${row.id}" title="Reject"><i class="fa-solid fa-xmark"></i></button> `;
                            }
                            if (row.status === 'Pending') {
                                btns += `<button type="button" class="btn btn-sm btn-outline-secondary btn-delete" data-id="${row.id}" title="Delete"><i class="fa-solid fa-trash"></i></button>`;
                            }
                            return `<div class="text-end">${btns}</div>`;
                        }
                    }
                ]
            });

            jQuery('#voucherTable tbody').on('click', '.btn-approve', function () {
                approveVoucher('@Url.Action("Approve", "BankReceiptVouchers")', jQuery(this).data('id'), token, function () { table.ajax.reload(); });
            });
            jQuery('#voucherTable tbody').on('click', '.btn-reject', function () {
                rejectVoucher('@Url.Action("Reject", "BankReceiptVouchers")', jQuery(this).data('id'), token, function () { table.ajax.reload(); });
            });
            jQuery('#voucherTable tbody').on('click', '.btn-delete', function () {
                confirmDelete('@Url.Action("Delete", "BankReceiptVouchers")', token, function () { table.ajax.reload(); }, { id: jQuery(this).data('id') });
            });
        });
    </script>
}
