@model ERP.Identity.Models.ViewModels.Payroll.MidSalaryRequestFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Mid Salary Request" : "New Mid Salary Request";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <form asp-controller="MidSalaryRequests" asp-action="Save" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="card animate__animated animate__fadeIn">
                <div class="card-header">
                    <h3 class="card-title">
                        Mid Salary Details
                        @if (isEdit)
                        {
                            <span class="badge bg-primary ms-2">@Model.RequestNumber</span>
                        }
                    </h3>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EmployeeId" class="form-label"></label>
                            <select asp-for="EmployeeId" id="employeeSelect" class="form-select select2" data-placeholder="Select employee">
                                <option></option>
                                @foreach (var e in Model.Employees)
                                {
                                    <option value="@e.Id" data-basic="@e.BasicSalary.ToString("0.00")" selected="@(e.Id == Model.EmployeeId)">@e.Name (@e.EmployeeCode)</option>
                                }
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" id="amount" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Basic Salary</label>
                            <input id="basicSalary" class="form-control" readonly disabled value="—" />
                            <div class="form-text" id="halfHint"></div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Reason" class="form-label"></label>
                            <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="alert alert-light border mt-3 mb-0 small">
                        An approved mid-salary draw is treated as an advance against this month's pay
                        and is recovered in full on the month's payslip.
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="MidSalaryRequests" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-paper-plane me-1"></i> @(isEdit ? "Update Request" : "Submit Request")
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showEmployee() {
            const sel = document.getElementById('employeeSelect');
            const opt = sel.options[sel.selectedIndex];
            const basic = opt ? parseFloat(opt.getAttribute('data-basic')) : NaN;

            const fmt = v => v.toLocaleString('en-PK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            document.getElementById('basicSalary').value = isNaN(basic) ? '—' : fmt(basic);
            document.getElementById('halfHint').textContent = isNaN(basic) ? '' : 'Half of basic: ' + fmt(basic / 2);
        }

        jQuery('#employeeSelect').on('change', showEmployee);
        showEmployee();
    </script>
}
