@model ERP.Identity.Models.ViewModels.Inventory.InternalTransferViewModel
@{
    ViewData["Title"] = "New Internal Transfer";
}

<form asp-controller="InternalTransfers" asp-action="Save" method="post" novalidate id="transferForm">
    @Html.AntiForgeryToken()

    <div class="card animate__animated animate__fadeIn">
        <div class="card-header"><h3 class="card-title">Transfer Details</h3></div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="TransferDate" class="form-label"></label>
                    <input asp-for="TransferDate" class="form-control datepicker" autocomplete="off" value="@Model.TransferDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label asp-for="FromLocationId" class="form-label"></label>
                    <select asp-for="FromLocationId" class="form-select select2" data-placeholder="From location">
                        <option></option>
                        @foreach (var l in Model.Locations)
                        {
                            <option value="@l.Id">@l.Name</option>
                        }
                    </select>
                    <span asp-validation-for="FromLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ToLocationId" class="form-label"></label>
                    <select asp-for="ToLocationId" class="form-select select2" data-placeholder="To location">
                        <option></option>
                        @foreach (var l in Model.Locations)
                        {
                            <option value="@l.Id">@l.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ToLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Remarks" class="form-label"></label>
                    <input asp-for="Remarks" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card animate__animated animate__fadeIn">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title">Products</h3>
            <button type="button" id="addRowBtn" class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-plus me-1"></i> Add Row
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table align-middle mb-0" id="itemsTable">
                <thead>
                    <tr>
                        <th style="width:40%">Product</th>
                        <th style="width:20%">Quantity</th>
                        <th style="width:30%">Remarks</th>
                        <th style="width:10%"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="card-footer text-end">
            <a asp-controller="InternalTransfers" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Post Transfer</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const productOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products ?? new List<ERP.Identity.Models.ViewModels.Inventory.ProductOption>(), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })) || [];
            let rowIndex = 0;

            function productSelectOptions() {
                return productOptions.map(function (p) { return `<option value="${p.id}">${p.name} (${p.code || p.sku})</option>`; }).join('');
            }

            function addItemRow() {
                const tbody = document.querySelector('#itemsTable tbody');
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <select name="Items[${rowIndex}].ProductId" class="form-select select2-row" data-placeholder="Select product">
                            <option></option>
                            ${productSelectOptions()}
                        </select>
                    </td>
                    <td><input type="number" step="0.001" min="0.001" name="Items[${rowIndex}].Quantity" class="form-control" /></td>
                    <td><input type="text" name="Items[${rowIndex}].Remarks" class="form-control" /></td>
                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="fa-solid fa-trash"></i></button></td>
                `;
                tbody.appendChild(tr);
                if (window.jQuery && jQuery.fn.select2) {
                    jQuery(tr).find('.select2-row').select2({ theme: 'bootstrap-5', width: '100%' });
                }
                rowIndex++;
            }

            document.getElementById('addRowBtn').addEventListener('click', addItemRow);

            document.querySelector('#itemsTable tbody').addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-remove-row');
                if (!btn) return;
                if (document.querySelectorAll('#itemsTable tbody tr').length <= 1) {
                    notyf.error('At least one product row is required.');
                    return;
                }
                btn.closest('tr').remove();
            });

            // Deferred so the browser finishes laying out the page first — running
            // this synchronously during initial parse could give Select2 a zero-width
            // trigger element to measure against, making the dropdown effectively
            // invisible for this first row.
            setTimeout(addItemRow, 0);

            document.getElementById('transferForm').addEventListener('submit', function (e) {
                const from = document.querySelector('[name="FromLocationId"]').value;
                const to = document.querySelector('[name="ToLocationId"]').value;
                if (from && to && from === to) {
                    e.preventDefault();
                    notyf.error('From and To locations must be different.');
                }
            });
        });
    </script>
}
