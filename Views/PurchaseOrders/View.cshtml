@model ERP.Identity.Models.Purchase.PurchaseOrder
@using ERP.Identity.Models.Inventory
@{
    ViewData["Title"] = $"PO {Model.PONumber}";
    var canApprove = (bool)(ViewBag.CanApprove ?? false);
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Purchase Order @Model.PONumber</h3>
        <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3 align-items-center">
            <div class="col-md-3"><small class="text-muted d-block">Date</small><strong>@Model.PODate.ToString("dd MMM yyyy")</strong></div>
            <div class="col-md-3"><small class="text-muted d-block">Vendor</small><strong>@Model.Vendor?.Name</strong></div>
            <div class="col-md-3"><small class="text-muted d-block">Expected Delivery</small><strong>@(Model.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</strong></div>
            <div class="col-md-3">
                <small class="text-muted d-block">Status</small>
                @if (Model.Status == VoucherStatus.Pending) { <span class="badge badge-status-pending">Pending</span> }
                else if (Model.Status == VoucherStatus.Approved) { <span class="badge badge-status-approved">Approved</span> }
                else { <span class="badge badge-status-rejected">Rejected</span> }
            </div>
            <div class="col-md-6"><small class="text-muted d-block">Remarks</small><strong>@(Model.Remarks ?? "—")</strong></div>
            @if (Model.Status != VoucherStatus.Pending)
            {
                <div class="col-md-6">
                    <small class="text-muted d-block">@(Model.Status == VoucherStatus.Approved ? "Approved By" : "Rejected By")</small>
                    <strong>@(Model.ApprovedByName ?? "—") on @Model.ApprovedOn?.ToString("dd MMM yyyy HH:mm")</strong>
                </div>
            }
            @if (Model.Status == VoucherStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="col-12"><small class="text-muted d-block">Rejection Reason</small><strong>@Model.RejectionReason</strong></div>
            }
        </div>

        <table class="table table-striped">
            <thead><tr><th>SKU</th><th>Product</th><th>Qty</th><th>Unit Price</th><th>Total</th><th>Remarks</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Product?.Sku</td>
                        <td>@item.Product?.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("N2")</td>
                        <td>@item.LineTotal.ToString("N2")</td>
                        <td>@(item.Remarks ?? "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="4" class="text-end">Total</th><th>@Model.TotalAmount.ToString("N2")</th><th></th></tr>
            </tfoot>
        </table>
    </div>
    @if (canApprove && Model.Status == VoucherStatus.Pending)
    {
        <div class="card-footer text-end">
            <button type="button" id="rejectBtn" class="btn btn-outline-danger"><i class="fa-solid fa-xmark me-1"></i> Reject</button>
            <button type="button" id="approveBtn" class="btn btn-success"><i class="fa-solid fa-check me-1"></i> Approve</button>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        document.getElementById('approveBtn')?.addEventListener('click', function () {
            approveVoucher('@Url.Action("Approve", "PurchaseOrders")', @Model.Id, token, function () { location.reload(); });
        });
        document.getElementById('rejectBtn')?.addEventListener('click', function () {
            rejectVoucher('@Url.Action("Reject", "PurchaseOrders")', @Model.Id, token, function () { location.reload(); });
        });
    </script>
}
