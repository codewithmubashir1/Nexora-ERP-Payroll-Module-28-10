@model ERP.Identity.Models.Accounts.Employee
@{
    Layout = null;
    var portrait = string.Equals((string?)ViewBag.Orientation, "portrait", StringComparison.OrdinalIgnoreCase);
    var department = (string?)ViewBag.DepartmentName ?? Model.Department ?? "—";
    var photo = string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? "/images/default-avatar.svg" : Model.ProfileImagePath;
    var orientation = portrait ? "portrait" : "landscape";
    var company = ViewBag.Company as ERP.Identity.Models.CompanySettings ?? new ERP.Identity.Models.CompanySettings();
    var qrDataUri = (string?)ViewBag.EmployeeQrDataUri;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Employee Card - @Model.EmployeeCode</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Ubuntu:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <style>
        body.employee-card-page { min-height: 100vh; padding: 2rem; background: #e9eef0; }
        .employee-card-toolbar { width: min(720px, 100%); margin: 0 auto 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
        .employee-card-pair { width: max-content; max-width: 100%; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 8mm; }
        .employee-id-card { --card-width: 85.6mm; --card-height: 54mm; width: var(--card-width); height: var(--card-height); padding: 3.2mm; position: relative; overflow: hidden; display: flex; flex-direction: column; color: #173441; background: #fff; border: .25mm solid #cbd7d9; border-radius: 2.5mm; box-shadow: 0 14px 34px rgba(23, 52, 65, .16); print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .employee-id-card::after { content: ''; position: absolute; width: 42mm; height: 42mm; right: -28mm; bottom: -30mm; border: .8mm solid rgba(19, 120, 111, .12); border-radius: 50%; pointer-events: none; }
        .employee-card-brand { min-height: 8mm; margin: -3.2mm -3.2mm 2mm; padding: 1.5mm 3mm; display: flex; align-items: center; gap: 1.8mm; color: #fff; background: #153a4a; font: 700 3mm 'Ubuntu', sans-serif; }
        .employee-card-brand i { color: #f5bd68; font-size: 3.8mm; }
        .employee-card-company { max-width: 55mm; line-height: 1.05; overflow-wrap: anywhere; }
        .employee-card-kind { color: #d7e8e6; font: 600 2.1mm 'Poppins', sans-serif; letter-spacing: .3mm; white-space: nowrap; }
        .employee-card-front-content { min-height: 0; flex: 1; display: flex; align-items: center; gap: 4mm; }
        .employee-card-photo { width: 27mm; height: 27mm; flex: 0 0 auto; object-fit: cover; border: .7mm solid #e4eef0; border-radius: 50%; background: #f2f6f6; }
        .employee-card-front-main { flex: 1; min-width: 0; }
        .employee-card-name { max-width: 100%; margin: 0; color: #132e3b; font: 700 5mm/1.05 'Ubuntu', sans-serif; overflow-wrap: anywhere; }
        .employee-card-role { max-width: 100%; margin: 1mm 0 2.3mm; color: #527079; font-size: 2.65mm; font-weight: 600; overflow-wrap: anywhere; }
        .employee-card-code { display: inline-flex; align-items: center; gap: 1mm; padding: .8mm 2.2mm; color: #12665f; background: #e8f5f1; border-radius: 20mm; font-size: 2.7mm; font-weight: 700; }
        .employee-card-front-meta { margin-top: 2.3mm; color: #49636b; font-size: 2.25mm; line-height: 1.25; }
        .employee-card-back-content { min-height: 0; flex: 1; display: flex; align-items: center; gap: 4mm; }
        .employee-card-qr-panel { width: 29mm; flex: 0 0 auto; text-align: center; }
        .employee-card-qr { display: block; width: 25mm; height: 25mm; margin: 0 auto 1mm; image-rendering: pixelated; }
        .employee-card-qr-caption { color: #657b80; font-size: 1.9mm; }
        .employee-card-details { flex: 1; min-width: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2mm 3mm; padding-left: 3mm; border-left: .25mm solid #dce5e6; }
        .employee-card-field { min-width: 0; }
        .employee-card-field span { display: block; color: #77888d; font-size: 1.8mm; font-weight: 700; text-transform: uppercase; }
        .employee-card-field strong { display: block; overflow: hidden; color: #233c47; font-size: 2.6mm; font-weight: 600; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
        .employee-card-blood { color: #ae3e48 !important; }
        .employee-card-return { min-height: 8mm; margin: 1.7mm -3.2mm -3.2mm; padding: 1.4mm 3.2mm; color: #fff; background: #13786f; font-size: 2mm; line-height: 1.15; }
        .employee-card-return strong { margin-right: 1mm; font-size: 2.3mm; }
        .employee-card-return-address { display: block; margin-top: .5mm; color: #e3f0ed; font-size: 1.8mm; }
        .employee-id-card.portrait { --card-width: 54mm; --card-height: 85.6mm; padding: 3.2mm; }
        .employee-id-card.portrait .employee-card-brand { margin: -3.2mm -3.2mm 2mm; padding-inline: 2.5mm; }
        .employee-id-card.portrait .employee-card-company { max-width: 29mm; font-size: 2.7mm; }
        .employee-id-card.portrait .employee-card-front-content { flex-direction: column; justify-content: center; gap: 2mm; text-align: center; }
        .employee-id-card.portrait .employee-card-photo { width: 25mm; height: 25mm; }
        .employee-id-card.portrait .employee-card-name { font-size: 4.3mm; }
        .employee-id-card.portrait .employee-card-role { margin: 1mm 0; font-size: 2.45mm; }
        .employee-id-card.portrait .employee-card-front-meta { margin-top: 1.5mm; }
        .employee-id-card.portrait .employee-card-back-content { flex-direction: column; justify-content: center; gap: 2mm; }
        .employee-id-card.portrait .employee-card-qr-panel { width: 100%; }
        .employee-id-card.portrait .employee-card-qr { width: 24mm; height: 24mm; }
        .employee-id-card.portrait .employee-card-details { width: 100%; flex: 0 0 auto; padding: 0; border-left: 0; }
        .employee-id-card.portrait .employee-card-field strong { font-size: 2.3mm; }
        @@page employeeCardLandscape { size: 85.6mm 54mm; margin: 0; }
        @@page employeeCardPortrait { size: 54mm 85.6mm; margin: 0; }
        @@media print {
            html, body.employee-card-page { width: auto; min-height: 0; margin: 0; padding: 0; overflow: visible; background: #fff !important; }
            body.employee-card-page * { visibility: hidden !important; }
            #printCards, #printCards * { visibility: visible !important; }
            #printCards { display: block; width: auto; margin: 0; }
            .employee-id-card { margin: 0; border: 0; border-radius: 0; box-shadow: none; page: employeeCardLandscape; break-after: page; page-break-after: always; }
            .employee-id-card.portrait { page: employeeCardPortrait; }
            .employee-id-card:last-child { break-after: auto; page-break-after: auto; }
            .employee-card-toolbar { display: none !important; }
        }
        @@media screen and (max-width: 575px) { body.employee-card-page { padding: 1rem .5rem; } .employee-card-toolbar { flex-wrap: wrap; } }
    </style>
</head>
<body class="employee-card-page">
    <div class="employee-card-toolbar">
        <div>
            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Employee</a>
            <a asp-controller="Employees" asp-action="Card" asp-route-id="@Model.Id" asp-route-orientation="@(portrait ? "landscape" : "portrait")" class="btn btn-light btn-sm">
                <i class="fa-solid fa-rotate me-1"></i> @(portrait ? "Landscape" : "Portrait")
            </a>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Employees" asp-action="ExportCardExcel" asp-route-id="@Model.Id" class="btn btn-outline-success btn-sm"><i class="fa-solid fa-file-excel me-1"></i> Excel</a>
            <button type="button" class="btn btn-primary btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print / PDF</button>
        </div>
    </div>

    <div id="printCards" class="employee-card-pair">
        <main id="employeeCardFront" class="employee-id-card @orientation @(portrait ? "portrait" : "landscape")">
            <header class="employee-card-brand"><i class="fa-solid fa-cubes-stacked"></i><span class="employee-card-company">@company.CompanyName</span><span class="employee-card-kind ms-auto">EMPLOYEE ID</span></header>
            <div class="employee-card-front-content">
                <img src="@photo" class="employee-card-photo" alt="Employee photo" />
                <div class="employee-card-front-main">
                    <h1 class="employee-card-name">@Model.Name</h1>
                    <p class="employee-card-role">@(Model.Designation ?? "Team Member")</p>
                    <span class="employee-card-code"><i class="fa-solid fa-id-badge"></i>@Model.EmployeeCode</span>
                    <div class="employee-card-front-meta"><strong>@department</strong><br />Employee identification card</div>
                </div>
            </div>
            <footer class="employee-card-return"><strong>@company.CompanyName</strong> · Official employee identification</footer>
        </main>

        <main id="employeeCardBack" class="employee-id-card back @orientation @(portrait ? "portrait" : "landscape")">
            <header class="employee-card-brand"><i class="fa-solid fa-cubes-stacked"></i><span class="employee-card-company">@company.CompanyName</span><span class="employee-card-kind ms-auto">EMPLOYEE DETAILS</span></header>
            <div class="employee-card-back-content">
                <div class="employee-card-qr-panel">
                    @if (!string.IsNullOrWhiteSpace(qrDataUri))
                    {
                        <img src="@qrDataUri" class="employee-card-qr" alt="QR code linking to the employee record" />
                    }
                    <span class="employee-card-qr-caption">Scan to verify employee record</span>
                </div>
                <div class="employee-card-details">
                    <div class="employee-card-field"><span>Employee</span><strong>@Model.Name</strong></div>
                    <div class="employee-card-field"><span>Employee code</span><strong>@Model.EmployeeCode</strong></div>
                    <div class="employee-card-field"><span>CNIC</span><strong>@(Model.CNICNumber ?? "—")</strong></div>
                    <div class="employee-card-field"><span>Department</span><strong>@department</strong></div>
                    <div class="employee-card-field"><span>Blood group</span><strong class="employee-card-blood">@(Model.BloodGroup ?? "—")</strong></div>
                    <div class="employee-card-field"><span>Phone</span><strong>@($"{Model.ContactCountryCode} {Model.Phone}".Trim())</strong></div>
                    <div class="employee-card-field"><span>Joined</span><strong>@(Model.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</strong></div>
                </div>
            </div>
            <footer class="employee-card-return">
                <strong>IF FOUND, PLEASE RETURN TO @company.CompanyName</strong>
                <span class="employee-card-return-address">@(string.IsNullOrWhiteSpace(company.Address) ? "Company address not set" : company.Address)</span>
            </footer>
        </main>
    </div>
</body>
</html>
