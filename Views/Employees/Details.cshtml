@model ERP.Identity.Models.ViewModels.Payroll.EmployeeDetailViewModel
@{
    var e = Model.Employee;
    ViewData["Title"] = e.Name;
    var avatar = string.IsNullOrEmpty(e.ProfileImagePath) ? "/images/default-avatar.svg" : e.ProfileImagePath;
    var gross = e.BasicSalary + e.HouseRentAllowance + e.MedicalAllowance + e.OtherAllowances;
    var hourlyRate = Model.ShiftHours > 0 ? e.BasicSalary / 30m / Model.ShiftHours : 0m;
}

<div class="row">
    <div class="col-lg-4">
        <div class="card animate__animated animate__fadeIn">
            <div class="card-body text-center">
                <img src="@avatar" class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover;" alt="@e.Name" />
                <h4 class="mb-0">@e.Name</h4>
                <p class="text-muted mb-1">@(e.Designation ?? "—")</p>
                <p class="mb-2"><span class="badge bg-primary">@e.EmployeeCode</span></p>
                @if (e.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Department</span><span>@(Model.DepartmentName ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Shift</span><span>@(Model.ShiftName ?? "Not set") <small class="text-muted">(@Model.ShiftHours.ToString("0.##") h)</small></span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">CNIC</span><span>@(e.CNICNumber ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Blood Group</span><span>@(e.BloodGroup ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Contact</span><span>@($"{e.ContactCountryCode} {e.Phone}".Trim())</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Email</span><span>@(e.Email ?? "—")</span></li>
                <li class="list-group-item"><span class="text-muted d-block">Address</span>@(e.Address ?? "—") @(string.IsNullOrEmpty(e.ZipCode) ? "" : $"({e.ZipCode})")</li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Joined</span><span>@(e.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Bank</span><span>@(e.BankName ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Account</span><span>@(e.BankAccountNumber ?? "—")</span></li>
            </ul>
            <div class="card-footer d-flex gap-2">
                <a asp-controller="Employees" asp-action="Card" asp-route-id="@e.Id" class="btn btn-outline-info btn-sm" title="Print employee card">
                    <i class="fa-solid fa-id-card me-1"></i> Card
                </a>
                <a asp-controller="Employees" asp-action="Edit" asp-route-id="@e.Id" class="btn btn-primary btn-sm flex-fill">
                    <i class="fa-solid fa-pen me-1"></i> Edit
                </a>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary btn-sm flex-fill">Back</a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row">
            <div class="col-md-3 col-6">
                <div class="small-box bg-primary">
                    <div class="inner"><h3 style="font-size:1.5rem;">@e.BasicSalary.ToString("N0")</h3><p>Basic Salary</p></div>
                    <div class="icon"><i class="fa-solid fa-money-bill"></i></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner"><h3 style="font-size:1.5rem;">@gross.ToString("N0")</h3><p>Gross Monthly</p></div>
                    <div class="icon"><i class="fa-solid fa-sack-dollar"></i></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="small-box bg-secondary">
                    <div class="inner"><h3 style="font-size:1.5rem;">@hourlyRate.ToString("N2")</h3><p>Overtime Rate / Hr</p></div>
                    <div class="icon"><i class="fa-solid fa-clock"></i></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner"><h3 style="font-size:1.5rem;">@Model.OutstandingAdvance.ToString("N0")</h3><p>Advance Outstanding</p></div>
                    <div class="icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                </div>
            </div>
        </div>

        <div class="card animate__animated animate__fadeIn">
            <div class="card-header"><h3 class="card-title"><i class="fa-solid fa-arrow-trend-up me-2"></i>Salary History</h3></div>
            <div class="card-body p-0">
                @if (Model.Increments.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No increments have been recorded.</p>
                }
                else
                {
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Effective</th>
                                <th class="text-end">From</th>
                                <th class="text-end">To</th>
                                <th class="text-end">Change</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inc in Model.Increments)
                            {
                                var diff = inc.NewBasicSalary - inc.OldBasicSalary;
                                <tr>
                                    <td>@inc.EffectiveDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">@inc.OldBasicSalary.ToString("N2")</td>
                                    <td class="text-end">@inc.NewBasicSalary.ToString("N2")</td>
                                    <td class="text-end @(diff >= 0 ? "text-success" : "text-danger")">@(diff >= 0 ? "+" : "")@diff.ToString("N2")</td>
                                    <td class="small text-muted">@(inc.Reason ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card animate__animated animate__fadeIn">
            <div class="card-header"><h3 class="card-title"><i class="fa-solid fa-receipt me-2"></i>Recent Payslips</h3></div>
            <div class="card-body p-0">
                @if (Model.RecentPayslips.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No payslips have been generated for this employee.</p>
                }
                else
                {
                    <table class="table table-sm table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Payslip #</th>
                                <th>Period</th>
                                <th class="text-end">Days</th>
                                <th class="text-end">Overtime</th>
                                <th class="text-end">Deductions</th>
                                <th class="text-end">Net Pay</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentPayslips)
                            {
                                <tr>
                                    <td>@p.PayslipNumber</td>
                                    <td>@(new DateTime(p.Year, p.Month, 1).ToString("MMM yyyy"))</td>
                                    <td class="text-end">@p.WorkingDays</td>
                                    <td class="text-end">@p.OvertimeAmount.ToString("N2")</td>
                                    <td class="text-end">@p.TotalDeductions.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@p.NetPay.ToString("N2")</td>
                                    <td>
                                        @{
                                            var cls = p.Status.ToString() switch
                                            {
                                                "Approved" => "badge-status-approved",
                                                "Rejected" => "badge-status-rejected",
                                                _ => "badge-status-pending"
                                            };
                                        }
                                        <span class="badge @cls">@p.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/Payroll/Payslips/View/@p.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
