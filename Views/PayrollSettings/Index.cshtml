@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Each modal is filled from the clicked row's data-* attributes; the New button
        // carries data-reset so the same modal doubles as the create form.
        const MODAL_FIELDS = {
            reimbursementModal: { name: 'name', limit: 'maxLimit' },
            leaveTypeModal:     { name: 'name', days: 'daysPerYear' },
            holidayModal:       { date: 'date', name: 'name' },
            statutoryModal:     { name: 'name', rate: 'ratePercent', ceiling: 'maxApplicableSalary' },
            taxSlabModal:       { min: 'minIncome', max: 'maxIncome', rate: 'ratePercent', fixed: 'fixedAmount' },
            deviceModal:        { name: 'name', location: 'location', ip: 'ipAddress', serial: 'serialNumber', type: 'deviceType' }
        };

        const MODAL_SWITCHES = {
            reimbursementModal: { active: 'isActive' },
            leaveTypeModal:     { paid: 'isPaid', encashable: 'isEncashable', active: 'isActive' },
            holidayModal:       { optional: 'isOptional' },
            statutoryModal:     { active: 'isActive' },
            taxSlabModal:       { active: 'isActive' },
            deviceModal:        { active: 'isActive' }
        };

        document.querySelectorAll('.modal').forEach(function (modal) {
            modal.addEventListener('show.bs.modal', function (event) {
                const trigger = event.relatedTarget;
                if (!trigger) return;

                const form = modal.querySelector('form');
                const isNew = trigger.hasAttribute('data-reset');
                const fields = MODAL_FIELDS[modal.id] || {};
                const switches = MODAL_SWITCHES[modal.id] || {};

                form.querySelector('input[name="id"]').value = isNew ? '0' : (trigger.getAttribute('data-id') || '0');

                Object.entries(fields).forEach(function ([attr, inputName]) {
                    const input = form.querySelector(`[name="${inputName}"]`);
                    if (input) input.value = isNew ? '' : (trigger.getAttribute('data-' + attr) || '');
                });

                Object.entries(switches).forEach(function ([attr, inputName]) {
                    const box = form.querySelector(`input[type="checkbox"][name="${inputName}"]`);
                    if (!box) return;
                    box.checked = isNew ? (inputName === 'isActive' || inputName === 'isPaid')
                                        : trigger.getAttribute('data-' + attr) === 'true';
                });
            });
        });

        // Row deletes all return JSON, so the page only reloads on success.
        document.querySelectorAll('.btn-row-delete').forEach(function (button) {
            button.addEventListener('click', function () {
                confirmDelete(this.getAttribute('data-url'), token,
                    function () { window.location.reload(); },
                    { id: button.getAttribute('data-id') });
            });
        });

        document.querySelectorAll('.btn-sync').forEach(function (button) {
            button.addEventListener('click', function () {
                fetch('/Payroll/Attendance/SyncDevice', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'deviceId=' + encodeURIComponent(button.getAttribute('data-id'))
                })
                    .then(r => r.json())
                    .then(d => d.success ? notyf.success(d.message) : notyf.error(d.message || 'Sync failed.'))
                    .catch(() => notyf.error('Request failed. Please try again.'));
            });
        });
    </script>
}
