@model ERP.Identity.Models.ViewModels.Accounts.JournalVoucherViewModel
@{
    ViewData["Title"] = "New Journal Voucher";
}

<form asp-controller="JournalVouchers" asp-action="Save" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div class="card animate__animated animate__fadeIn">
        <div class="card-header"><h3 class="card-title">Voucher Details</h3></div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="VoucherDate" class="form-label"></label>
                    <input asp-for="VoucherDate" class="form-control datepicker" autocomplete="off" value="@Model.VoucherDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-9">
                    <label asp-for="Narration" class="form-label"></label>
                    <input asp-for="Narration" class="form-control" placeholder="Overall description of this entry" />
                </div>
            </div>
        </div>
    </div>

    <div class="card animate__animated animate__fadeIn">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title">Debit / Credit Lines</h3>
            <button type="button" id="addRowBtn" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-plus me-1"></i> Add Line</button>
        </div>
        <div class="card-body p-0">
            <table class="table align-middle mb-0" id="itemsTable">
                <thead>
                    <tr>
                        <th style="width:26%">Account</th>
                        <th style="width:12%">Debit</th>
                        <th style="width:12%">Credit</th>
                        <th style="width:18%">Party (optional)</th>
                        <th style="width:22%">Narration</th>
                        <th style="width:10%"></th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <td class="text-end fw-bold">Totals</td>
                        <td class="fw-bold" id="totalDebitCell">0.00</td>
                        <td class="fw-bold" id="totalCreditCell">0.00</td>
                        <td colspan="2"><span id="balanceIndicator" class="badge bg-secondary">Enter lines</span></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-footer text-end">
            <a asp-controller="JournalVouchers" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Submit for Approval</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const accountOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Accounts, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            const customers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Customers, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            const vendors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Vendors, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            const employees = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Employees, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            let rowIndex = 0;

            function accountSelectOptions() {
                return accountOptions.map(function (a) { return `<option value="${a.id}">${a.accountCode} — ${a.accountName}</option>`; }).join('');
            }

            function partySelectOptions() {
                let html = '<option value="">No party</option>';
                if (customers.length) html += '<optgroup label="Customers">' + customers.map(c => `<option value="Customer:${c.id}">${c.name} (${c.customerCode})</option>`).join('') + '</optgroup>';
                if (vendors.length) html += '<optgroup label="Vendors">' + vendors.map(v => `<option value="Vendor:${v.id}">${v.name} (${v.vendorCode})</option>`).join('') + '</optgroup>';
                if (employees.length) html += '<optgroup label="Employees">' + employees.map(e => `<option value="Employee:${e.id}">${e.name} (${e.employeeCode})</option>`).join('') + '</optgroup>';
                return html;
            }

            function addItemRow() {
                const tbody = document.querySelector('#itemsTable tbody');
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <select name="Lines[${rowIndex}].AccountId" class="form-select select2-row" data-placeholder="Select account">
                            <option></option>
                            ${accountSelectOptions()}
                        </select>
                    </td>
                    <td><input type="number" step="0.01" min="0" name="Lines[${rowIndex}].Debit" class="form-control row-debit" /></td>
                    <td><input type="number" step="0.01" min="0" name="Lines[${rowIndex}].Credit" class="form-control row-credit" /></td>
                    <td>
                        <select class="form-select select2-row party-select">
                            ${partySelectOptions()}
                        </select>
                        <input type="hidden" name="Lines[${rowIndex}].PartyType" class="party-type-hidden" value="0" />
                        <input type="hidden" name="Lines[${rowIndex}].PartyId" class="party-id-hidden" />
                    </td>
                    <td><input type="text" name="Lines[${rowIndex}].Narration" class="form-control" /></td>
                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="fa-solid fa-trash"></i></button></td>
                `;
                tbody.appendChild(tr);
                if (window.jQuery && jQuery.fn.select2) {
                    jQuery(tr).find('.select2-row').select2({ theme: 'bootstrap-5', width: '100%' });

                    jQuery(tr).find('.party-select').on('change', function () {
                        const parts = (this.value || '').split(':');
                        const typeMap = { 'Customer': 1, 'Vendor': 2, 'Employee': 3 };
                        tr.querySelector('.party-type-hidden').value = parts.length === 2 ? typeMap[parts[0]] : 0;
                        tr.querySelector('.party-id-hidden').value = parts.length === 2 ? parts[1] : '';
                    });
                }
                rowIndex++;
            }

            function recalcTotals() {
                let totalDebit = 0, totalCredit = 0;
                document.querySelectorAll('#itemsTable tbody tr').forEach(function (row) {
                    totalDebit += parseFloat(row.querySelector('.row-debit').value) || 0;
                    totalCredit += parseFloat(row.querySelector('.row-credit').value) || 0;
                });

                document.getElementById('totalDebitCell').textContent = totalDebit.toFixed(2);
                document.getElementById('totalCreditCell').textContent = totalCredit.toFixed(2);

                const indicator = document.getElementById('balanceIndicator');
                if (totalDebit === 0 && totalCredit === 0) {
                    indicator.className = 'badge bg-secondary';
                    indicator.textContent = 'Enter lines';
                } else if (Math.abs(totalDebit - totalCredit) < 0.005) {
                    indicator.className = 'badge bg-success';
                    indicator.textContent = 'Balanced';
                } else {
                    indicator.className = 'badge bg-danger';
                    indicator.textContent = `Out of balance by ${Math.abs(totalDebit - totalCredit).toFixed(2)}`;
                }
            }

            document.getElementById('addRowBtn').addEventListener('click', function () { addItemRow(); recalcTotals(); });

            document.querySelector('#itemsTable tbody').addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-remove-row');
                if (!btn) return;
                if (document.querySelectorAll('#itemsTable tbody tr').length <= 2) {
                    notyf.error('A journal voucher needs at least two lines.');
                    return;
                }
                btn.closest('tr').remove();
                recalcTotals();
            });

            document.querySelector('#itemsTable tbody').addEventListener('input', function (e) {
                if (e.target.classList.contains('row-debit') || e.target.classList.contains('row-credit')) {
                    recalcTotals();
                }
            });

            setTimeout(function () { addItemRow(); addItemRow(); recalcTotals(); }, 0);
        });
    </script>
}
