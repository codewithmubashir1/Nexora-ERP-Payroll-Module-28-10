@model ERP.Identity.Models.Accounts.JournalVoucher
@using ERP.Identity.Models.Inventory
@using ERP.Identity.Models.Accounts
@{
    ViewData["Title"] = $"JV {Model.VoucherNumber}";
    var canApprove = (bool)(ViewBag.CanApprove ?? false);
    var partyNames = (Dictionary<string, string>)(ViewBag.PartyNames ?? new Dictionary<string, string>());
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Journal Voucher @Model.VoucherNumber</h3>
        <div class="d-flex gap-2">
            <a asp-controller="JournalVouchers" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print me-1"></i> Print</a>
            <a asp-controller="JournalVouchers" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3 align-items-center">
            <div class="col-md-3"><small class="text-muted d-block">Date</small><strong>@Model.VoucherDate.ToString("dd MMM yyyy")</strong></div>
            <div class="col-md-6"><small class="text-muted d-block">Narration</small><strong>@(Model.Narration ?? "—")</strong></div>
            <div class="col-md-3">
                <small class="text-muted d-block">Status</small>
                @if (Model.Status == VoucherStatus.Pending) { <span class="badge badge-status-pending">Pending</span> }
                else if (Model.Status == VoucherStatus.Approved) { <span class="badge badge-status-approved">Approved (posted to ledger)</span> }
                else { <span class="badge badge-status-rejected">Rejected</span> }
            </div>
        </div>

        <table class="table table-striped">
            <thead><tr><th>Account</th><th>Debit</th><th>Credit</th><th>Party</th><th>Narration</th></tr></thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    var partyKey = line.PartyType != PartyType.None && line.PartyId.HasValue ? $"{line.PartyType}:{line.PartyId}" : null;
                    <tr>
                        <td>@line.Account?.AccountCode — @line.Account?.AccountName</td>
                        <td>@(line.Debit > 0 ? line.Debit.ToString("N2") : "—")</td>
                        <td>@(line.Credit > 0 ? line.Credit.ToString("N2") : "—")</td>
                        <td>@(partyKey != null && partyNames.ContainsKey(partyKey) ? $"{line.PartyType}: {partyNames[partyKey]}" : "—")</td>
                        <td>@(line.Narration ?? "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th class="text-end">Totals</th>
                    <th>@Model.Lines.Sum(l => l.Debit).ToString("N2")</th>
                    <th>@Model.Lines.Sum(l => l.Credit).ToString("N2")</th>
                    <th colspan="2"></th>
                </tr>
            </tfoot>
        </table>
    </div>
    @if (canApprove && Model.Status == VoucherStatus.Pending)
    {
        <div class="card-footer text-end">
            <button type="button" id="rejectBtn" class="btn btn-outline-danger"><i class="fa-solid fa-xmark me-1"></i> Reject</button>
            <button type="button" id="approveBtn" class="btn btn-success"><i class="fa-solid fa-check me-1"></i> Approve &amp; Post</button>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        document.getElementById('approveBtn')?.addEventListener('click', function () {
            approveVoucher('@Url.Action("Approve", "JournalVouchers")', @Model.Id, token, function () { location.reload(); });
        });
        document.getElementById('rejectBtn')?.addEventListener('click', function () {
            rejectVoucher('@Url.Action("Reject", "JournalVouchers")', @Model.Id, token, function () { location.reload(); });
        });
    </script>
}
