@model ERP.Identity.Models.ViewModels.Purchase.PurchaseInvoicePaymentViewModel
@{
    ViewData["Title"] = "New Purchase Invoice Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <form asp-controller="PurchaseInvoicePayments" asp-action="Save" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Payment Details</h3></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="VendorId" class="form-label"></label>
                            <select asp-for="VendorId" id="vendorSelect" class="form-select select2" data-placeholder="Select vendor">
                                <option></option>
                                @foreach (var v in Model.Vendors) { <option value="@v.Id">@v.Name (@v.VendorCode)</option> }
                            </select>
                            <span asp-validation-for="VendorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="form-label"></label>
                            <input asp-for="PaymentDate" class="form-control datepicker" autocomplete="off" value="@Model.PaymentDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchaseInvoiceId" class="form-label"></label>
                            <select asp-for="PurchaseInvoiceId" id="invoiceSelect" class="form-select select2" data-placeholder="Select an invoice with a balance">
                                <option></option>
                                @foreach (var i in Model.Invoices) { <option value="@i.Id" data-vendor-id="@i.VendorId" data-balance="@i.Balance.ToString("F2")">@i.InvoiceNumber (Balance: @i.Balance.ToString("N2"))</option> }
                            </select>
                            <span asp-validation-for="PurchaseInvoiceId" class="text-danger small"></span>
                            <div class="form-text">Choosing a vendor narrows this list to that vendor's unpaid invoices.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" id="amountInput" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WithholdingTaxRate" class="form-label"></label>
                            <select asp-for="WithholdingTaxRate" id="whtSelect" class="form-select select2">
                                <option value="">No Withholding Tax</option>
                                @foreach (var rate in new[] { 0m, 0.5m, 1m, 1.5m, 2m, 2.5m, 3m, 3.5m, 4m, 4.5m, 5m, 5.5m })
                                {
                                    <option value="@rate.ToString(System.Globalization.CultureInfo.InvariantCulture)">@rate%</option>
                                }
                            </select>
                            <div class="form-text" id="netPaymentHint">Deducted from the amount actually disbursed to the vendor.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <select asp-for="PaymentMethod" id="paymentMethodSelect" class="form-select select2">
                                <option value="0">Cash</option>
                                <option value="1">Bank Transfer</option>
                                <option value="2">Cheque</option>
                            </select>
                        </div>
                        <div class="col-md-4" id="chequeField" style="display:none;">
                            <label asp-for="IssuedChequeId" class="form-label"></label>
                            <select asp-for="IssuedChequeId" class="form-select select2" data-placeholder="Select issued cheque">
                                <option></option>
                                @foreach (var c in Model.Cheques) { <option value="@c.Id">@c.ChequeReferenceNo (@c.ChequeNumber)</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="VendorAdvanceId" class="form-label"></label>
                            <select asp-for="VendorAdvanceId" class="form-select select2" data-placeholder="Optional — adjust from an advance">
                                <option></option>
                                @foreach (var a in Model.Advances) { <option value="@a.Id">@a.AdvanceNumber (Available: @a.AvailableAmount.ToString("N2"))</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label"></label>
                            <input asp-for="Remarks" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="PurchaseInvoicePayments" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Submit for Approval</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleChequeField() {
            const method = document.getElementById('paymentMethodSelect').value;
            document.getElementById('chequeField').style.display = method === '2' ? 'block' : 'none';
        }
        jQuery('#paymentMethodSelect').on('change', toggleChequeField);
        toggleChequeField();

        // Live calculation: Net Payment = Amount - (Amount x WHT% / 100), shown as
        // a hint under the Withholding Tax dropdown — this is the actual cash/bank
        // /cheque disbursement, since the invoice balance is still reduced by the
        // full Amount.
        function recalcNetPayment() {
            const amount = parseFloat(document.getElementById('amountInput').value) || 0;
            const whtPct = parseFloat(document.getElementById('whtSelect').value) || 0;
            const hint = document.getElementById('netPaymentHint');

            if (whtPct > 0 && amount > 0) {
                const whtAmount = amount * whtPct / 100;
                const net = amount - whtAmount;
                hint.textContent = `Withholding: ${whtAmount.toFixed(2)} — Net payment to vendor: ${net.toFixed(2)}`;
            } else {
                hint.textContent = 'Deducted from the amount actually disbursed to the vendor.';
            }
        }
        jQuery('#whtSelect').on('change', recalcNetPayment);
        document.getElementById('amountInput').addEventListener('input', recalcNetPayment);

        // Narrow the invoice dropdown to the selected vendor's unpaid invoices.
        jQuery('#vendorSelect').on('change', function () {
            const vendorId = this.value;
            const invoiceSelect = jQuery('#invoiceSelect');
            invoiceSelect.empty().append('<option></option>');

            if (!vendorId) { invoiceSelect.trigger('change'); return; }

            fetch(`/Purchase/Payments/GetInvoicesForVendor/${vendorId}`)
                .then(r => r.json())
                .then(data => {
                    data.forEach(inv => {
                        invoiceSelect.append(`<option value="${inv.id}" data-vendor-id="${inv.vendorId}" data-balance="${Number(inv.balance).toFixed(2)}">${inv.invoiceNumber} (Balance: ${Number(inv.balance).toFixed(2)})</option>`);
                    });
                    invoiceSelect.trigger('change');
                })
                .catch(() => notyf.error('Could not load invoices for this vendor.'));
        });

        // Selecting an invoice auto-populates the vendor (if not already set) and
        // pre-fills the payment amount with that invoice's outstanding balance —
        // both stay fully editable afterward.
        jQuery('#invoiceSelect').on('change', function () {
            const selected = this.options[this.selectedIndex];
            if (!selected || !selected.value) return;

            const vendorId = selected.getAttribute('data-vendor-id');
            const balance = selected.getAttribute('data-balance');

            if (vendorId && jQuery('#vendorSelect').val() !== vendorId) {
                jQuery('#vendorSelect').val(vendorId).trigger('change.select2');
            }
            if (balance) {
                document.querySelector('[name="Amount"]').value = balance;
            }
        });
    </script>
}
