@model ERP.Identity.Models.ViewModels.PrintDocumentViewModel
@{
    Layout = null;
    var logoSrc = string.IsNullOrEmpty(Model.Company.LogoPath) ? null : Model.Company.LogoPath;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.DocumentTypeTitle @Model.DocumentNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        body { background: #eef0f2; font-family: "Segoe UI", Arial, sans-serif; color: #1f2937; }
        .toolbar { position: sticky; top: 0; z-index: 20; background: #fff; border-bottom: 1px solid #e5e7eb; padding: .75rem 0; }
        .print-sheet { max-width: 980px; margin: 1.5rem auto; background: #fff; padding: 40px; border: 1px solid #e5e7eb; }
        .doc-title { font-size: 1.1rem; font-weight: 800; letter-spacing: .03em; }
        .info-box td { padding: 2px 6px; font-size: .78rem; vertical-align: top; }
        .info-box td:first-child { font-weight: 700; white-space: nowrap; color: #374151; }
        .status-pill { border: 1px solid #9ca3af; border-radius: 4px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: .75rem; }
        .header-col { border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px 14px; height: 100%; }
        .party-heading { font-weight: 800; font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #1f2937; padding-bottom: 4px; margin-bottom: 6px; }
        .party-block p { margin: 0 0 2px; font-size: .8rem; }
        .items-table th { background: #f3f4f6; font-size: .72rem; text-transform: uppercase; letter-spacing: .03em; border-bottom: 2px solid #d1d5db !important; position: relative; user-select: none; }
        .items-table td, .items-table th { font-size: .8rem; padding: .45rem .55rem; }
        .col-resize-handle { position: absolute; right: 0; top: 0; bottom: 0; width: 6px; cursor: col-resize; }
        .col-resize-handle:hover { background: rgba(37,99,235,.35); }
        .totals-box td { padding: 4px 6px; font-size: .82rem; }
        .totals-box tr:last-child td { border-top: 2px solid #1f2937; font-weight: 800; font-size: .92rem; }
        .signature-line { border-top: 1px dashed #9ca3af; padding-top: 6px; margin-top: 55px; text-align: center; font-size: .78rem; }
        .logo-img { max-height: 46px; max-width: 170px; object-fit: contain; margin-bottom: 6px; }
        .col-toggle-panel { max-height: 220px; overflow-y: auto; }
        @@media print {
            body { background: #fff; }
            .toolbar, .col-toggle-panel-wrapper { display: none !important; }
            .print-sheet { border: none; margin: 0; padding: 0; max-width: 100%; }
            .col-resize-handle { display: none; }
        }
    </style>
</head>
<body>
    <form id="documentShareToken" class="d-none">@Html.AntiForgeryToken()</form>
    <div class="toolbar">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-muted"><i class="fa-solid fa-file-lines me-1"></i> @Model.DocumentTypeTitle @Model.DocumentNumber</span>
            <div class="d-flex gap-2 align-items-center col-toggle-panel-wrapper position-relative">
                <div class="dropdown">
                    <button type="button" class="btn btn-outline-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="fa-solid fa-table-columns me-1"></i> Columns
                    </button>
                    <div class="dropdown-menu p-2 col-toggle-panel" id="columnTogglePanel" style="min-width:220px;"></div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.close()"><i class="fa-solid fa-xmark me-1"></i> Close</button>
                <button type="button" class="btn btn-outline-success btn-sm" id="exportExcelBtn"><i class="fa-solid fa-file-excel me-1"></i> Excel</button>
                <button type="button" class="btn btn-outline-danger btn-sm" id="exportPdfBtn"><i class="fa-solid fa-file-pdf me-1"></i> PDF</button>
                <button type="button" class="btn btn-outline-success btn-sm" id="shareWhatsAppBtn"><i class="fa-brands fa-whatsapp me-1"></i> WhatsApp</button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="shareEmailBtn"><i class="fa-solid fa-envelope me-1"></i> Email</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
            </div>
        </div>
    </div>

    <div class="print-sheet" id="printSheet">
        <div class="row g-2 mb-3">
            <div class="col-4">
                <div class="header-col party-block">
                    <div class="party-heading">Our Information</div>
                    @if (logoSrc != null)
                    {
                        <img src="@logoSrc" class="logo-img d-block" alt="@Model.Company.CompanyName" />
                    }
                    <p class="fw-bold">@Model.Company.CompanyName</p>
                    @if (!string.IsNullOrEmpty(Model.Company.Address)) { <p>@Model.Company.Address</p> }
                    @if (!string.IsNullOrEmpty(Model.Company.Email)) { <p>Email: @Model.Company.Email</p> }
                    @if (!string.IsNullOrEmpty(Model.Company.Phone)) { <p>Phone: @Model.Company.Phone</p> }
                    @if (!string.IsNullOrEmpty(Model.Company.NTNNumber)) { <p>NTN: @Model.Company.NTNNumber</p> }
                    @if (!string.IsNullOrEmpty(Model.Company.SalesTaxRegistrationNumber)) { <p>STRN: @Model.Company.SalesTaxRegistrationNumber</p> }
                </div>
            </div>
            <div class="col-4">
                <div class="header-col party-block">
                    <div class="party-heading">@Model.PartyLabel</div>
                    <p class="fw-bold">@(Model.PartyName ?? "—")</p>
                    @if (!string.IsNullOrEmpty(Model.PartyCode)) { <p>Code: @Model.PartyCode</p> }
                    @if (!string.IsNullOrEmpty(Model.PartyVendorCode)) { <p>Our Vendor Code: @Model.PartyVendorCode</p> }
                    @if (!string.IsNullOrEmpty(Model.PartyAddress)) { <p>@Model.PartyAddress</p> }
                    @if (!string.IsNullOrEmpty(Model.PartyEmail)) { <p>Email: @Model.PartyEmail</p> }
                    @if (!string.IsNullOrEmpty(Model.PartyPhone)) { <p>Phone: @Model.PartyPhone</p> }
                    @if (!string.IsNullOrEmpty(Model.PartyNTN)) { <p>NTN: @Model.PartyNTN</p> }
                    @if (!string.IsNullOrEmpty(Model.PartySTRN)) { <p>STRN: @Model.PartySTRN</p> }
                </div>
            </div>
            <div class="col-4">
                <div class="header-col">
                    <div class="doc-title mb-1">@Model.DocumentTypeTitle</div>
                    <table class="info-box">
                        <tr><td>@Model.DocumentNumberLabel</td><td>@Model.DocumentNumber</td></tr>
                        @foreach (var r in Model.ExtraRefs)
                        {
                            <tr><td>@r.Label</td><td>@r.Value</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.Status))
                        {
                            <tr><td>STATUS</td><td><span class="status-pill">@Model.Status.ToUpper()</span></td></tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <table class="table table-bordered items-table mb-3" id="itemsTable">
            <thead>
                <tr id="itemsTableHeadRow">
                    @for (var c = 0; c < Model.Columns.Count; c++)
                    {
                        <th data-col-index="@c">@Model.Columns[c]<span class="col-resize-handle"></span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @for (var c = 0; c < row.Count; c++)
                        {
                            <td data-col-index="@c">@row[c]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <div class="row">
            <div class="col-7">
                @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
                {
                    <p class="fw-bold mb-1">Additional Notes:</p>
                    <p class="small">@Model.AdditionalNotes</p>
                }
                @if (!string.IsNullOrEmpty(Model.AmountInWords))
                {
                    <p class="small mb-1"><strong>Amount in Words:</strong> @Model.AmountInWords</p>
                }
                @if (!string.IsNullOrEmpty(Model.TaxAmountInWords))
                {
                    <p class="small mb-1"><strong>Tax Amount in Words:</strong> @Model.TaxAmountInWords</p>
                }
                @if (!string.IsNullOrEmpty(Model.ApprovedByName))
                {
                    <p class="small text-muted mt-3">Approved by @Model.ApprovedByName on @Model.ApprovedOn?.ToString("dd MMM yyyy")</p>
                }
            </div>
            <div class="col-5">
                <table class="w-100 totals-box">
                    @foreach (var t in Model.Totals)
                    {
                        <tr><td>@t.Label</td><td class="text-end @(t.Bold ? "fw-bold" : "")">@t.Value</td></tr>
                    }
                </table>
            </div>
        </div>

        @if (Model.ShowBankDetails && (!string.IsNullOrEmpty(Model.Company.BankName) || !string.IsNullOrEmpty(Model.Company.BankAccountNumber)))
        {
            <div class="mt-4">
                <div class="party-heading">Bank Details</div>
                <table class="table table-bordered w-50">
                    <tr><td class="fw-bold">Bank Name</td><td>@(Model.Company.BankName ?? "—")</td></tr>
                    <tr><td class="fw-bold">Account Title</td><td>@(Model.Company.BankAccountTitle ?? "—")</td></tr>
                    <tr><td class="fw-bold">Account Number</td><td>@(Model.Company.BankAccountNumber ?? "—")</td></tr>
                </table>
            </div>
        }

        <div class="row mt-5">
            <div class="col-4"><div class="signature-line">Prepared By</div></div>
            <div class="col-4"><div class="signature-line">Approved By</div></div>
            <div class="col-4"><div class="signature-line">Checked By</div></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ---------- Real-time column show/hide ----------
        const columnLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Columns));
        const togglePanel = document.getElementById('columnTogglePanel');

        columnLabels.forEach(function (label, idx) {
            const wrapper = document.createElement('div');
            wrapper.className = 'form-check';
            wrapper.innerHTML = `
                <input class="form-check-input col-toggle-checkbox" type="checkbox" value="${idx}" id="colToggle${idx}" checked>
                <label class="form-check-label small" for="colToggle${idx}">${label}</label>
            `;
            togglePanel.appendChild(wrapper);
        });

        togglePanel.addEventListener('change', function (e) {
            if (!e.target.classList.contains('col-toggle-checkbox')) return;
            const idx = e.target.value;
            const visible = e.target.checked;
            document.querySelectorAll(`#itemsTable [data-col-index="${idx}"]`).forEach(function (cell) {
                cell.style.display = visible ? '' : 'none';
            });
        });

        // ---------- Real-time column width adjustment via border drag ----------
        (function enableColumnResize() {
            let activeHandle = null, startX = 0, startWidth = 0, activeTh = null;

            document.querySelectorAll('#itemsTableHeadRow th').forEach(function (th) {
                th.style.width = th.offsetWidth + 'px';
            });

            document.querySelectorAll('.col-resize-handle').forEach(function (handle) {
                handle.addEventListener('mousedown', function (e) {
                    activeHandle = handle;
                    activeTh = handle.closest('th');
                    startX = e.pageX;
                    startWidth = activeTh.offsetWidth;
                    document.body.style.cursor = 'col-resize';
                    e.preventDefault();
                });
            });

            document.addEventListener('mousemove', function (e) {
                if (!activeHandle) return;
                const newWidth = Math.max(40, startWidth + (e.pageX - startX));
                activeTh.style.width = newWidth + 'px';
            });

            document.addEventListener('mouseup', function () {
                activeHandle = null;
                activeTh = null;
                document.body.style.cursor = '';
            });
        })();

        // ---------- Export handlers ----------
        const pdfFileName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{Model.DocumentTypeTitle.Replace(" ", "_")}_{Model.DocumentNumber}.pdf"));

        function createDocumentPdf() {
            return html2canvas(document.getElementById('printSheet'), { scale: 1.5, useCORS: true }).then(function (canvas) {
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF(canvas.width > canvas.height ? 'l' : 'p', 'pt', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const imageHeight = (canvas.height * pageWidth) / canvas.width;
                const image = canvas.toDataURL('image/jpeg', .84);
                let position = 0;
                let heightLeft = imageHeight;
                pdf.addImage(image, 'JPEG', 0, position, pageWidth, imageHeight);
                heightLeft -= pageHeight;
                while (heightLeft > 0) {
                    position -= pageHeight;
                    pdf.addPage();
                    pdf.addImage(image, 'JPEG', 0, position, pageWidth, imageHeight);
                    heightLeft -= pageHeight;
                }
                return pdf.output('blob');
            });
        }

        document.getElementById('exportPdfBtn').addEventListener('click', async function () {
            const btn = this;
            btn.disabled = true;
            try {
                const blob = await createDocumentPdf();
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = pdfFileName;
                link.click();
                setTimeout(() => URL.revokeObjectURL(link.href), 1000);
            } catch { alert('Could not generate PDF. Please try Print instead.'); }
            finally { btn.disabled = false; }
        });

        document.getElementById('exportExcelBtn').addEventListener('click', function () {
            const wb = XLSX.utils.table_to_book(document.getElementById('itemsTable'), { sheet: 'Items' });
            XLSX.writeFile(wb, '@(Model.DocumentTypeTitle.Replace(" ", "_"))_@(Model.DocumentNumber).xlsx');
        });

        const shareDocument = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            title = $"{Model.DocumentTypeTitle} {Model.DocumentNumber}",
            status = Model.Status ?? "Prepared",
            party = Model.PartyName ?? "",
            phone = Model.PartyPhone ?? "",
            email = Model.PartyEmail ?? ""
        }));

        function shareMessage() {
            const recipient = shareDocument.party ? ` for ${shareDocument.party}` : '';
            return `${shareDocument.title}${recipient}\nStatus: ${shareDocument.status}\nPlease find the document reference above.`;
        }

        document.getElementById('shareWhatsAppBtn').addEventListener('click', async function () {
            try { await shareDocumentViaWhatsApp(); }
            catch (error) { if (error.name !== 'AbortError') alert(error.message || 'Could not share the PDF.'); }
        });

        async function shareDocumentViaWhatsApp() {
            const file = new File([await createDocumentPdf()], pdfFileName, { type: 'application/pdf' });
            if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
                await navigator.share({ files: [file], title: shareDocument.title, text: shareMessage() });
                return;
            }

            const link = document.createElement('a');
            const blob = file;
            link.href = URL.createObjectURL(blob);
            link.download = pdfFileName;
            link.click();
            setTimeout(() => URL.revokeObjectURL(link.href), 1000);
            let phone = shareDocument.phone.replace(/\D/g, '');
            if (phone.startsWith('0')) phone = '92' + phone.slice(1);
            if (!phone) phone = (prompt('Enter the recipient phone number with country code:') || '').replace(/\D/g, '');
            if (phone) window.open(`https://wa.me/${phone}?text=${encodeURIComponent(shareMessage())}`, '_blank', 'noopener');
            alert('This browser cannot attach files through WhatsApp. The PDF was downloaded; attach it in the WhatsApp chat.');
        }

        document.getElementById('shareEmailBtn').addEventListener('click', async function () {
            const recipient = shareDocument.email || prompt('Recipient email address:');
            if (!recipient) return;
            const btn = this;
            btn.disabled = true;
            try {
                const pdf = await createDocumentPdf();
                const form = new FormData();
                form.append('pdf', pdf, pdfFileName);
                form.append('recipient', recipient);
                form.append('subject', shareDocument.title);
                form.append('message', shareMessage());
                const token = document.querySelector('#documentShareToken input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Documents/EmailPdf', { method: 'POST', headers: { RequestVerificationToken: token }, body: form });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Email delivery failed.');
                alert(result.message);
            } catch (error) { alert(error.message || 'Could not send the PDF attachment.'); }
            finally { btn.disabled = false; }
        });
    </script>
</body>
</html>
