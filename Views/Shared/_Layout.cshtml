                        <li class="nav-item"><a asp-controller="Users" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-users-gear"></i><p>Users &amp; Roles</p></a></li>
                    }
                    <li class="nav-item"><a asp-controller="Company" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-building"></i><p>Company</p></a></li>
                    <li class="nav-item"><a asp-controller="Settings" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-gears"></i><p>Settings</p></a></li>

                    <li class="nav-header">MY ACCOUNT</li>
                    <li class="nav-item"><a asp-controller="Profile" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-user"></i><p>My Account</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><h3 class="mb-0">@ViewData["Title"]</h3></div>
                    <div class="col-sm-6 text-sm-end">
                        <span class="text-muted small">@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="app-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="app-footer text-center text-muted small py-2">
        &copy; @DateTime.Now.Year ERP System. All rights reserved.
    </footer>
</div>

<!-- Hidden logout form (submitted via SweetAlert2 confirmation, see site.js) -->
<form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

