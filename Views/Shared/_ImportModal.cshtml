@model ERP.Identity.Models.ViewModels.ImportModalViewModel

<div class="modal fade" id="@Model.Id" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form class="import-form" data-action="@Model.ActionUrl" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-file-import me-2"></i>@Model.Title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@Model.Description</p>
                    <a href="@Model.TemplateUrl" class="btn btn-outline-secondary btn-sm mb-3">
                        <i class="fa-solid fa-download me-1"></i> Download CSV Template
                    </a>
                    <div class="mb-2">
                        <label class="form-label">CSV File</label>
                        <input type="file" name="file" accept=".csv" class="form-control file-control" required />
                    </div>
                    <div class="import-result mt-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-upload me-1"></i> Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
