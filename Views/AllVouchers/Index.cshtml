@{
    ViewData["Title"] = "All Vouchers";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title">All Vouchers</h3>
        <div class="all-vouchers-filters d-flex gap-2 flex-wrap">
            <select id="typeFilter" class="form-select form-select-sm select2" style="width:300px; min-width:250px;">
                <option value="">All Voucher Types</option>
                <option value="Journal Voucher">Journal Voucher</option>
                <option value="Cash Payment Voucher">Cash Payment Voucher</option>
                <option value="Cash Receipt Voucher">Cash Receipt Voucher</option>
                <option value="Bank Payment Voucher">Bank Payment Voucher</option>
                <option value="Bank Receipt Voucher">Bank Receipt Voucher</option>
                <option value="Inventory Voucher">Inventory Voucher</option>
            </select>
            <select id="statusFilter" class="form-select form-select-sm select2" style="width:300px; min-width:250px;">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
    </div>
    <div class="card-body">
        <table id="allVouchersTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Voucher Type</th>
                    <th>Voucher No.</th>
                    <th>Date</th>
                    <th>Detail</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        jQuery(function () {
            const table = jQuery('#allVouchersTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "AllVouchers")', dataSrc: 'data' },
                order: [[2, 'desc']],
                columns: [
                    { data: 'voucherType' },
                    { data: 'voucherNumber' },
                    { data: 'voucherDate', render: d => new Date(d).toLocaleDateString('en-PK') },
                    { data: 'detail' },
                    { data: 'amount', render: d => Number(d).toFixed(2) },
                    { data: 'status', render: d => statusBadge(d) },
                    {
                        data: null, orderable: false,
                        render: function (row) {
                            let btns = '';
                            if (row.viewUrl) btns += `<a href="${row.viewUrl}" class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a> `;
                            btns += `<a href="${row.printUrl}" target="_blank" class="btn btn-sm btn-outline-dark" title="Print / Export"><i class="fa-solid fa-print"></i></a>`;
                            return `<div class="text-end">${btns}</div>`;
                        }
                    }
                ]
            });

            jQuery('#typeFilter').on('change', function () {
                table.column(0).search(this.value).draw();
            });
            jQuery('#statusFilter').on('change', function () {
                table.column(5).search(this.value).draw();
            });
        });
    </script>
}
