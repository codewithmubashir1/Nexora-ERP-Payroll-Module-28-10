@model ERP.Identity.Models.Payroll.Payslip
@{
    Layout = null;
    var company = ViewBag.Company as ERP.Identity.Models.CompanySettings;
    var period = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var e = Model.Employee;
    var shiftHours = e?.ShiftTiming?.ShiftHours ?? 8m;
    var hourlyRate = shiftHours > 0 ? Model.BasicSalary / 30m / shiftHours : 0m;
    var earnedBasic = Math.Round(Model.BasicSalary / 30m * Model.WorkingDays, 2);
    var logo = string.IsNullOrEmpty(company?.LogoPath) ? null : company!.LogoPath;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Payslip @Model.PayslipNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        body { background: #eef0f2; font-family: "Segoe UI", Arial, sans-serif; color: #1f2937; }
        .toolbar { position: sticky; top: 0; z-index: 20; background: #fff; border-bottom: 1px solid #e5e7eb; padding: .75rem 0; }
        .print-sheet { max-width: 860px; margin: 1.5rem auto; background: #fff; padding: 40px; border: 1px solid #e5e7eb; }
        .doc-title { font-size: 1.1rem; font-weight: 800; letter-spacing: .05em; }
        .section-heading { font-weight: 800; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #1f2937; padding-bottom: 4px; margin-bottom: 6px; }
        table.detail td { font-size: .8rem; padding: .3rem .4rem; }
        table.detail td:first-child { color: #374151; }
        .totals-row td { border-top: 2px solid #1f2937; font-weight: 800; font-size: .95rem; }
        .status-pill { border: 1px solid #9ca3af; border-radius: 4px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: .72rem; }
        .signature-line { border-top: 1px dashed #9ca3af; padding-top: 6px; margin-top: 55px; text-align: center; font-size: .78rem; }
        @@media print {
            .toolbar { display: none; }
            body { background: #fff; }
            .print-sheet { border: 0; margin: 0; padding: 0; max-width: 100%; }
        }
    </style>
</head>
<body>
    <form id="payslipShareToken" class="d-none">@Html.AntiForgeryToken()</form>
    <div class="toolbar text-center">
        <button class="btn btn-outline-danger btn-sm" id="exportPayslipPdf"><i class="fa-solid fa-file-pdf me-1"></i> PDF</button>
        <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.close()">Close</button>
        <button class="btn btn-outline-success btn-sm" id="sharePayslipWhatsApp"><i class="fa-brands fa-whatsapp me-1"></i> WhatsApp</button>
        <button class="btn btn-outline-primary btn-sm" id="sharePayslipEmail"><i class="fa-solid fa-envelope me-1"></i> Email</button>
    </div>

    <div class="print-sheet">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                @if (logo != null)
                {
                    <img src="@logo" alt="logo" style="max-height:56px;" class="me-3" />
                }
                <div>
                    <div class="fw-bold fs-5">@(company?.CompanyName ?? "Company")</div>
                    <div class="small text-muted">@company?.Address</div>
                    <div class="small text-muted">@company?.Phone</div>
                </div>
            </div>
            <div class="text-end">
                <div class="doc-title">SALARY SLIP</div>
                <div class="small">Payslip #: <strong>@Model.PayslipNumber</strong></div>
                <div class="small">Period: <strong>@period</strong></div>
                <div class="mt-1"><span class="status-pill">@Model.Status.ToString().ToUpperInvariant()</span></div>
            </div>
        </div>

        <div class="row g-4 mb-3">
            <div class="col-6">
                <div class="section-heading">Employee</div>
                <table class="detail w-100">
                    <tr><td>Name</td><td class="fw-semibold">@(e?.Name ?? "—")</td></tr>
                    <tr><td>Code</td><td>@(e?.EmployeeCode ?? "—")</td></tr>
                    <tr><td>CNIC</td><td>@(e?.CNICNumber ?? "—")</td></tr>
                    <tr><td>Department</td><td>@(e?.DepartmentRef?.Name ?? e?.Department ?? "—")</td></tr>
                    <tr><td>Designation</td><td>@(e?.Designation ?? "—")</td></tr>
                    <tr><td>Bank / Account</td><td>@(e?.BankName ?? "—") @(string.IsNullOrEmpty(e?.BankAccountNumber) ? "" : $"· {e!.BankAccountNumber}")</td></tr>
                </table>
            </div>
            <div class="col-6">
                <div class="section-heading">Attendance</div>
                <table class="detail w-100">
                    <tr><td>Shift</td><td>@(e?.ShiftTiming?.Name ?? "Not set") (@shiftHours.ToString("0.##") h)</td></tr>
                    <tr><td>Working (payable) days</td><td>@Model.WorkingDays</td></tr>
                    <tr><td>Present days</td><td>@Model.PresentDays</td></tr>
                    <tr><td>Absent days</td><td>@Model.AbsentDays</td></tr>
                    <tr><td>Leave days</td><td>@Model.LeaveDays</td></tr>
                    <tr><td>Overtime / Late hours</td><td>@Model.OvertimeHours.ToString("N2") / @Model.LateHours.ToString("N2")</td></tr>
                </table>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-6">
                <div class="section-heading">Earnings</div>
                <table class="detail w-100">
                    <tr><td>Basic salary (full month)</td><td class="text-end">@Model.BasicSalary.ToString("N2")</td></tr>
                    <tr><td>Earned basic (basic / 30 &times; @Model.WorkingDays)</td><td class="text-end">@earnedBasic.ToString("N2")</td></tr>
                    <tr><td>House rent allowance</td><td class="text-end">@Model.HouseRentAllowance.ToString("N2")</td></tr>
                    <tr><td>Medical allowance</td><td class="text-end">@Model.MedicalAllowance.ToString("N2")</td></tr>
                    <tr><td>Other allowances</td><td class="text-end">@Model.OtherAllowances.ToString("N2")</td></tr>
                    <tr><td>Hourly rate (basic / 30 / @shiftHours.ToString("0.##"))</td><td class="text-end">@hourlyRate.ToString("N2")</td></tr>
                    <tr><td>Net hours (overtime &minus; late)</td><td class="text-end">@Model.NetHours.ToString("N2")</td></tr>
                    <tr><td>Overtime amount</td><td class="text-end">@Model.OvertimeAmount.ToString("N2")</td></tr>
                </table>
            </div>
            <div class="col-6">
                <div class="section-heading">Deductions</div>
                <table class="detail w-100">
                    <tr><td>Advance previous balance</td><td class="text-end">@Model.AdvancePreviousBalance.ToString("N2")</td></tr>
                    <tr><td>Advance given this month</td><td class="text-end">@Model.CurrentAdvanceGiven.ToString("N2")</td></tr>
                    <tr><td>Total advance</td><td class="text-end">@Model.TotalAdvance.ToString("N2")</td></tr>
                    <tr><td>Advance deducted</td><td class="text-end">@Model.AdvanceDeducted.ToString("N2")</td></tr>
                    <tr><td>Advance remaining</td><td class="text-end">@Model.AdvanceRemainingBalance.ToString("N2")</td></tr>
                    <tr><td>Fixed monthly deduction</td><td class="text-end">@Model.FixedMonthlyDeduction.ToString("N2")</td></tr>
                    <tr><td>Income tax</td><td class="text-end">@Model.IncomeTaxDeduction.ToString("N2")</td></tr>
                    <tr><td>Statutory deductions</td><td class="text-end">@Model.StatutoryDeductions.ToString("N2")</td></tr>
                    <tr><td>Other deductions</td><td class="text-end">@Model.OtherDeductions.ToString("N2")</td></tr>
                    <tr><td class="fw-bold">Total deductions</td><td class="text-end fw-bold">@Model.TotalDeductions.ToString("N2")</td></tr>
                </table>
            </div>
        </div>

        <table class="detail w-100 mt-4">
            <tr class="totals-row">
                <td>NET PAYABLE</td>
                <td class="text-end">@Model.NetPay.ToString("N2")</td>
            </tr>
        </table>

        <div class="row mt-2">
            <div class="col-6"><div class="signature-line">Employee Signature</div></div>
            <div class="col-6"><div class="signature-line">Authorised Signature</div></div>
        </div>

        <p class="text-center text-muted small mt-4 mb-0">
            This is a system-generated payslip. The fixed monthly deduction is credited to the employee's ledger.
        </p>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>
    <script>
        const payslipShare = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            title = $"Salary Slip {Model.PayslipNumber} - {period}",
            employee = e?.Name ?? "",
            status = Model.Status.ToString(),
            phone = e?.Phone ?? "",
            email = e?.Email ?? ""
        }));
        const payslipShareMessage = `${payslipShare.title} for ${payslipShare.employee}\nStatus: ${payslipShare.status}`;
        const payslipPdfName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"Payslip_{Model.PayslipNumber}.pdf"));

        function createPayslipPdf() {
            return html2canvas(document.querySelector('.print-sheet'), { scale: 1.5, useCORS: true }).then(canvas => {
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF(canvas.width > canvas.height ? 'l' : 'p', 'pt', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const imageHeight = canvas.height * pageWidth / canvas.width;
                const image = canvas.toDataURL('image/jpeg', .84);
                let position = 0;
                let remaining = imageHeight;
                pdf.addImage(image, 'JPEG', 0, position, pageWidth, imageHeight);
                remaining -= pageHeight;
                while (remaining > 0) {
                    position -= pageHeight;
                    pdf.addPage();
                    pdf.addImage(image, 'JPEG', 0, position, pageWidth, imageHeight);
                    remaining -= pageHeight;
                }
                return pdf.output('blob');
            });
        }

        document.getElementById('exportPayslipPdf').addEventListener('click', async function () {
            try {
                const blob = await createPayslipPdf();
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = payslipPdfName;
                link.click();
                setTimeout(() => URL.revokeObjectURL(link.href), 1000);
            } catch { alert('Could not generate PDF. Please use Print instead.'); }
        });

        document.getElementById('sharePayslipWhatsApp').addEventListener('click', async function () {
            try {
                const file = new File([await createPayslipPdf()], payslipPdfName, { type: 'application/pdf' });
                if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
                    await navigator.share({ files: [file], title: payslipShare.title, text: payslipShareMessage });
                    return;
                }
                const link = document.createElement('a');
                link.href = URL.createObjectURL(file);
                link.download = payslipPdfName;
                link.click();
                setTimeout(() => URL.revokeObjectURL(link.href), 1000);
                let phone = payslipShare.phone.replace(/\D/g, '');
                if (phone.startsWith('0')) phone = '92' + phone.slice(1);
                if (!phone) phone = (prompt('Enter the recipient phone number with country code:') || '').replace(/\D/g, '');
                if (phone) window.open(`https://wa.me/${phone}?text=${encodeURIComponent(payslipShareMessage)}`, '_blank', 'noopener');
                alert('This browser cannot attach files through WhatsApp. The PDF was downloaded; attach it in the WhatsApp chat.');
            } catch (error) { if (error.name !== 'AbortError') alert(error.message || 'Could not share the payslip PDF.'); }
        });
        document.getElementById('sharePayslipEmail').addEventListener('click', async function () {
            const recipient = payslipShare.email || prompt('Recipient email address:');
            if (!recipient) return;
            try {
                const form = new FormData();
                form.append('pdf', await createPayslipPdf(), payslipPdfName);
                form.append('recipient', recipient);
                form.append('subject', payslipShare.title);
                form.append('message', payslipShareMessage);
                const token = document.querySelector('#payslipShareToken input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Documents/EmailPdf', { method: 'POST', headers: { RequestVerificationToken: token }, body: form });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Email delivery failed.');
                alert(result.message);
            } catch (error) { alert(error.message || 'Could not send the payslip PDF.'); }
        });
    </script>
</body>
</html>
