@{
    ViewData["Title"] = "Payslips";
    var canApprove = ViewBag.CanApprove != null && (bool)ViewBag.CanApprove;
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Payslips</h3>
        <div class="d-flex gap-2">
            <a asp-controller="SalarySheet" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-table-list me-1"></i> Salary Sheet
            </a>
            <a asp-controller="Payslips" asp-action="Generate" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Generate Payslips
            </a>
            @if (canApprove)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#importPayrollAdjustmentsModal">
                    <i class="fa-solid fa-file-import me-1"></i> Import Adjustments
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label">Month</label>
                <select id="filterMonth" class="form-select form-select-sm">
                    <option value="">All months</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select id="filterYear" class="form-select form-select-sm">
                    <option value="">All years</option>
                    @for (var y = DateTime.Today.Year - 5; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" id="applyFilter" class="btn btn-outline-primary btn-sm w-100">Apply</button>
            </div>
        </div>

        <table id="payslipsTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Payslip #</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Period</th>
                    <th>Pay Run</th>
                    <th class="text-end">Basic</th>
                    <th class="text-end">Overtime</th>
                    <th class="text-end">Deductions</th>
                    <th class="text-end">Net Pay</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (canApprove)
{
    <partial name="_ImportModal" model='new ERP.Identity.Models.ViewModels.ImportModalViewModel {
        Id = "importPayrollAdjustmentsModal", Title = "Import Payroll Adjustments",
        ActionUrl = Url.Action("ImportAdjustments", "Payslips"),
        TemplateUrl = Url.Action("ImportTemplate", "Payslips"),
        Description = "Imports tax, statutory, and other deductions into matching pending payslips only. Approved payslips are never changed."
    }' />
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const canApprove = @(canApprove ? "true" : "false");
        const money = d => Number(d).toLocaleString('en-PK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        jQuery(function () {
            const table = jQuery('#payslipsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetAll", "Payslips")',
                    data: function (d) {
                        d.month = jQuery('#filterMonth').val() || null;
                        d.year = jQuery('#filterYear').val() || null;
                    },
                    dataSrc: 'data'
                },
                order: [[0, 'desc']],
                columns: [
                    { data: 'payslipNumber' },
                    {
                        data: null,
                        render: row => `<div>${row.employeeName}</div><small class="text-muted">${row.employeeCode}</small>`
                    },
                    { data: 'departmentName', render: d => d || '—' },
                    { data: 'period' },
                    { data: 'payRunNumber', render: d => d || '<span class="text-muted">Standalone</span>' },
                    { data: 'basicSalary', className: 'text-end', render: money },
                    { data: 'overtimeAmount', className: 'text-end', render: money },
                    { data: 'totalDeductions', className: 'text-end', render: money },
                    { data: 'netPay', className: 'text-end fw-semibold', render: money },
                    { data: 'status', render: d => statusBadge(d) },
                    {
                        data: null, orderable: false,
                        render: function (row) {
                            let html = '<div class="text-end text-nowrap">';
                            html += `<a href="/Payroll/Payslips/View/${row.id}" class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a> `;
                            html += `<a href="/Payroll/Payslips/Print/${row.id}" target="_blank" class="btn btn-sm btn-outline-secondary" title="Print"><i class="fa-solid fa-print"></i></a> `;

                            if (row.status === 'Pending' && canApprove) {
                                html += `<button type="button" class="btn btn-sm btn-outline-info btn-recalc" data-id="${row.id}" title="Recalculate"><i class="fa-solid fa-rotate"></i></button> `;
                                html += `<button type="button" class="btn btn-sm btn-outline-success btn-approve" data-id="${row.id}" title="Approve"><i class="fa-solid fa-check"></i></button> `;
                                html += `<button type="button" class="btn btn-sm btn-outline-warning btn-reject" data-id="${row.id}" title="Reject"><i class="fa-solid fa-xmark"></i></button> `;
                            }

                            if (row.status !== 'Approved') {
                                html += `<button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${row.id}" title="Delete"><i class="fa-solid fa-trash"></i></button>`;
                            }

                            return html + '</div>';
                        }
                    }
                ]
            });

            const reload = () => table.ajax.reload(null, false);
            jQuery('#applyFilter').on('click', reload);

            const body = jQuery('#payslipsTable tbody');

            body.on('click', '.btn-approve', function () {
                approveVoucher('@Url.Action("Approve", "Payslips")', jQuery(this).data('id'), token, reload);
            });

            body.on('click', '.btn-reject', function () {
                rejectVoucher('@Url.Action("Reject", "Payslips")', jQuery(this).data('id'), token, reload);
            });

            body.on('click', '.btn-delete', function () {
                confirmDelete('@Url.Action("Delete", "Payslips")', token, reload, { id: jQuery(this).data('id') });
            });

            body.on('click', '.btn-recalc', function () {
                const id = jQuery(this).data('id');
                fetch('@Url.Action("Recalculate", "Payslips")', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(id)
                })
                    .then(r => r.json())
                    .then(function (data) {
                        if (data.success) { notyf.success(data.message); reload(); }
                        else { notyf.error(data.message || 'Could not recalculate.'); }
                    })
                    .catch(() => notyf.error('Request failed. Please try again.'));
            });
        });
    </script>
}
