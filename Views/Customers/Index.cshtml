@{
    ViewData["Title"] = "Customers";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Customers</h3>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#importCustomerModal">
                <i class="fa-solid fa-file-import me-1"></i> Import
            </button>
            <a asp-controller="Customers" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus me-1"></i> New Customer
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="customersTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Contact</th>
                    <th>Phone</th>
                    <th>Terms (days)</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

<partial name="_ImportModal" model='new ERP.Identity.Models.ViewModels.ImportModalViewModel {
    Id = "importCustomerModal", Title = "Import Customers",
    ActionUrl = Url.Action("Import", "Customers"),
    TemplateUrl = Url.Action("Template", "Customers"),
    Description = "Create or update customers in bulk. Matches existing customers by Name. Category must match an existing customer category name exactly."
}' />

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        jQuery(function () {
            const table = jQuery('#customersTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "Customers")', dataSrc: 'data' },
                order: [[0, 'desc']],
                columns: [
                    { data: 'customerCode' },
                    { data: 'name' },
                    { data: 'categoryName' },
                    { data: 'contactPerson', render: d => d || '—' },
                    { data: 'phone', render: d => d || '—' },
                    { data: 'paymentTermsDays' },
                    {
                        data: 'isActive',
                        render: d => d ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'
                    },
                    {
                        data: 'id', orderable: false,
                        render: id => `
                            <div class="text-end">
                                <a href="/Accounts/Ledgers?partyType=Customer&partyId=${id}" class="btn btn-sm btn-outline-info" title="View customer ledger"><i class="fa-solid fa-book-open"></i></a>
                                <a href="/Sales/Customers/Edit/${id}" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${id}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </div>`
                    }
                ]
            });

            jQuery('#customersTable tbody').on('click', '.btn-delete', function () {
                const id = jQuery(this).data('id');
                confirmDelete('@Url.Action("Delete", "Customers")', token, function () { table.ajax.reload(); }, { id: id });
            });

            document.addEventListener('erp:import-success', function () { table.ajax.reload(); });
        });
    </script>
}
