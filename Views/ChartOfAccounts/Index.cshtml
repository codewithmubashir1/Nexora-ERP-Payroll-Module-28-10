@{
    ViewData["Title"] = "Chart of Accounts";
}

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Chart of Accounts</h3>
        <a asp-controller="ChartOfAccounts" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i> New Account
        </a>
    </div>
    <div class="card-body">
        <table id="accountsTable" class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Account Name</th>
                    <th>Type</th>
                    <th>Parent</th>
                    <th>Opening Balance</th>
                    <th>Current Balance</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        jQuery(function () {
            const table = jQuery('#accountsTable').DataTable({
                ajax: { url: '@Url.Action("GetAll", "ChartOfAccounts")', dataSrc: 'data' },
                order: [[0, 'asc']],
                columns: [
                    { data: 'accountCode' },
                    { data: 'accountName' },
                    { data: 'accountType' },
                    { data: 'parentAccountName', render: d => d || '—' },
                    { data: 'openingBalance', render: d => Number(d).toFixed(2) },
                    { data: 'currentBalance', render: d => Number(d).toFixed(2) },
                    {
                        data: 'isActive',
                        render: d => d ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'
                    },
                    {
                        data: null, orderable: false,
                        render: function (row) {
                            let btns = `<a href="/Accounts/ChartOfAccounts/Edit/${row.id}" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>`;
                            if (!row.isSystemAccount) {
                                btns += ` <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${row.id}" title="Delete"><i class="fa-solid fa-trash"></i></button>`;
                            } else {
                                btns += ` <span class="badge bg-light text-dark border ms-1" title="Used by automated postings">System</span>`;
                            }
                            return `<div class="text-end">${btns}</div>`;
                        }
                    }
                ]
            });

            jQuery('#accountsTable tbody').on('click', '.btn-delete', function () {
                const id = jQuery(this).data('id');
                confirmDelete('@Url.Action("Delete", "ChartOfAccounts")', token, function () { table.ajax.reload(); }, { id: id });
            });
        });
    </script>
}
