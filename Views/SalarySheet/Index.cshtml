@model ERP.Identity.Models.ViewModels.Payroll.SalarySheetViewModel
@{
    ViewData["Title"] = "Salary Sheet";
}

<div class="card animate__animated animate__fadeIn salary-sheet-filter">
    <div class="card-header"><h3 class="card-title">Filter</h3></div>
    <div class="card-body">
        <form asp-controller="SalarySheet" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    @for (var y = DateTime.Today.Year - 5; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Department</label>
                <select name="departmentId" class="form-select select2" data-placeholder="All departments">
                    <option value="">All departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(d.Id == Model.DepartmentId)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="fa-solid fa-magnifying-glass me-1"></i> Show</button>
                <a class="btn btn-outline-secondary flex-fill"
                   asp-controller="SalarySheet" asp-action="Export"
                   asp-route-month="@Model.Month" asp-route-year="@Model.Year" asp-route-departmentId="@Model.DepartmentId">
                    <i class="fa-solid fa-file-csv me-1"></i> Export
                </a>
                <button type="button" class="btn btn-outline-secondary flex-fill" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
            </div>
        </form>
    </div>
</div>

<div class="card animate__animated animate__fadeIn">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">@Model.MonthName <span class="badge bg-secondary ms-1">@Model.Rows.Count payslip(s)</span></h3>
        <span class="fw-semibold">Total net payable: @Model.TotalNetPay.ToString("N2")</span>
    </div>
    <div class="card-body">
        @if (Model.Rows.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-file-circle-question fa-2x text-muted mb-3"></i>
                <p class="text-muted mb-3">No payslips exist for @Model.MonthName.</p>
                <a asp-controller="Payslips" asp-action="Generate" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Generate Payslips
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="salarySheetTable" class="table table-sm table-striped table-hover align-middle salary-sheet">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th class="text-end">Basic</th>
                            <th class="text-end">Days</th>
                            <th class="text-end">Attendance Hrs</th>
                            <th class="text-end">Earned</th>
                            <th class="text-end">OT Hrs</th>
                            <th class="text-end">Late Hrs</th>
                            <th class="text-end">Net Hrs</th>
                            <th class="text-end">OT Amount</th>
                            <th class="text-end">Prev. Adv.</th>
                            <th class="text-end">New Adv.</th>
                            <th class="text-end">Total Adv.</th>
                            <th class="text-end">Adv. Deducted</th>
                            <th class="text-end">Adv. Left</th>
                            <th class="text-end">Fixed Ded.</th>
                            <th class="text-end">Total Ded.</th>
                            <th class="text-end">Net Payable</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.EmployeeName</div>
                                    <small class="text-muted">@r.EmployeeCode</small>
                                </td>
                                <td class="small text-muted">@(r.DepartmentName ?? "—")</td>
                                <td class="text-end">@r.BasicSalary.ToString("N2")</td>
                                <td class="text-end">@r.WorkingDays</td>
                                <td class="text-end">@r.AttendanceHours.ToString("N2")</td>
                                <td class="text-end">@r.EarnedBasic.ToString("N2")</td>
                                <td class="text-end">@r.OvertimeHours.ToString("N2")</td>
                                <td class="text-end">@r.LateHours.ToString("N2")</td>
                                <td class="text-end @(r.NetHours < 0 ? "text-danger" : "")">@r.NetHours.ToString("N2")</td>
                                <td class="text-end">@r.OvertimeAmount.ToString("N2")</td>
                                <td class="text-end">@r.AdvancePreviousBalance.ToString("N2")</td>
                                <td class="text-end">@r.CurrentAdvanceGiven.ToString("N2")</td>
                                <td class="text-end">@r.TotalAdvance.ToString("N2")</td>
                                <td class="text-end">@r.AdvanceDeducted.ToString("N2")</td>
                                <td class="text-end">@r.AdvanceRemainingBalance.ToString("N2")</td>
                                <td class="text-end">@r.FixedMonthlyDeduction.ToString("N2")</td>
                                <td class="text-end">@r.TotalDeductions.ToString("N2")</td>
                                <td class="text-end fw-semibold">@r.NetPay.ToString("N2")</td>
                                <td>
                                    @{
                                        var cls = r.Status switch
                                        {
                                            "Approved" => "badge-status-approved",
                                            "Rejected" => "badge-status-rejected",
                                            _ => "badge-status-pending"
                                        };
                                    }
                                    <span class="badge @cls">@r.Status</span>
                                </td>
                                <td class="text-end">
                                    <a href="/Payroll/Payslips/View/@r.PayslipId" class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td colspan="4" class="text-end">Totals</td>
                            <td class="text-end">@Model.TotalAttendanceHours.ToString("N2")</td>
                            <td class="text-end">@Model.TotalEarnedBasic.ToString("N2")</td>
                            <td colspan="3"></td>
                            <td class="text-end">@Model.TotalOvertimeAmount.ToString("N2")</td>
                            <td colspan="3"></td>
                            <td class="text-end">@Model.TotalAdvanceDeducted.ToString("N2")</td>
                            <td></td>
                            <td class="text-end">@Model.TotalFixedDeduction.ToString("N2")</td>
                            <td class="text-end">@Model.TotalDeductionsSum.ToString("N2")</td>
                            <td class="text-end">@Model.TotalNetPay.ToString("N2")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .salary-sheet th, .salary-sheet td { font-size: .78rem; white-space: nowrap; }
        @@media print {
            .salary-sheet-filter, .app-header, .app-sidebar, .app-footer, .card-header .badge { display: none !important; }
            .table-responsive { overflow: visible !important; }
            .salary-sheet { font-size: 8pt; }
        }
    </style>
}
