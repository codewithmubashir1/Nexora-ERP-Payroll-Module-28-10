@{
    ViewData["Title"] = "Invoices & Recoveries";
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#customerTab" type="button">Customer Receivables</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#vendorTab" type="button">Vendor Payables</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="customerTab">
        <div class="card animate__animated animate__fadeIn">
            <div class="card-header"><h3 class="card-title">Customer Invoices &amp; Recoveries</h3></div>
            <div class="card-body">
                <table id="customerTable" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Customer</th>
                            <th>Total Invoiced</th>
                            <th>Total Recovered</th>
                            <th>Outstanding</th>
                            <th>Days Overdue</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="vendorTab">
        <div class="card animate__animated animate__fadeIn">
            <div class="card-header"><h3 class="card-title">Vendor Invoices &amp; Recoveries</h3></div>
            <div class="card-body">
                <table id="vendorTable" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Vendor</th>
                            <th>Total Invoiced</th>
                            <th>Total Paid</th>
                            <th>Outstanding</th>
                            <th>Days Overdue</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function overdueBadge(days) {
            if (days <= 0) return '<span class="badge bg-success">Current</span>';
            if (days <= 30) return `<span class="badge bg-warning">${days} days</span>`;
            return `<span class="badge bg-danger">${days} days</span>`;
        }

        jQuery(function () {
            jQuery('#customerTable').DataTable({
                ajax: { url: '@Url.Action("GetCustomerSummary", "InvoicesAndRecoveries")', dataSrc: 'data' },
                order: [[4, 'desc']],
                columns: [
                    { data: 'customerCode' },
                    { data: 'name' },
                    { data: 'totalInvoiced', render: d => Number(d).toFixed(2) },
                    { data: 'totalRecovered', render: d => Number(d).toFixed(2) },
                    { data: 'outstanding', render: d => Number(d).toFixed(2) },
                    { data: 'daysOverdue', render: d => overdueBadge(d) },
                    {
                        data: 'id', orderable: false,
                        render: id => `<div class="text-end"><a href="/Accounts/AccountStatements?partyType=Customer&partyId=${id}" class="btn btn-sm btn-outline-secondary" title="View Statement"><i class="fa-solid fa-file-invoice"></i></a></div>`
                    }
                ]
            });

            jQuery('#vendorTable').DataTable({
                ajax: { url: '@Url.Action("GetVendorSummary", "InvoicesAndRecoveries")', dataSrc: 'data' },
                order: [[4, 'desc']],
                columns: [
                    { data: 'vendorCode' },
                    { data: 'name' },
                    { data: 'totalInvoiced', render: d => Number(d).toFixed(2) },
                    { data: 'totalRecovered', render: d => Number(d).toFixed(2) },
                    { data: 'outstanding', render: d => Number(d).toFixed(2) },
                    { data: 'daysOverdue', render: d => overdueBadge(d) },
                    {
                        data: 'id', orderable: false,
                        render: id => `<div class="text-end"><a href="/Accounts/AccountStatements?partyType=Vendor&partyId=${id}" class="btn btn-sm btn-outline-secondary" title="View Statement"><i class="fa-solid fa-file-invoice"></i></a></div>`
                    }
                ]
            });
        });
    </script>
}
