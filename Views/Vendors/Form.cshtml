@model ERP.Identity.Models.ViewModels.Purchase.VendorFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Vendor" : "New Vendor";
}

<form asp-controller="Vendors" asp-action="Save" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-lg-4">
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Identifiers</h3></div>
                <div class="card-body">
                    @if (isEdit)
                    {
                        <div class="mb-3">
                            <label class="form-label">Vendor Code</label>
                            <input value="@Model.VendorCode" class="form-control" readonly disabled />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Vendor Code</label>
                            <input value="Auto-generated on save" class="form-control" readonly disabled />
                        </div>
                    }
                    <div class="mb-2">
                        <label asp-for="VendorCategoryId" class="form-label"></label>
                        <select asp-for="VendorCategoryId" class="form-select select2" data-placeholder="Select category">
                            <option></option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.VendorCategoryId)">@c.Name</option>
                            }
                        </select>
                        <span asp-validation-for="VendorCategoryId" class="text-danger small"></span>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Vendor Details</h3></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PaymentTermsDays" class="form-label"></label>
                            <select asp-for="PaymentTermsDays" class="form-select select2">
                                <option value="0">On Receipt</option>
                                <option value="7">7 Days</option>
                                <option value="15">15 Days</option>
                                <option value="30">30 Days</option>
                                <option value="45">45 Days</option>
                                <option value="60">60 Days</option>
                                <option value="75">75 Days</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactPerson" class="form-label"></label>
                            <input asp-for="ContactPerson" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control phone-input" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NTNNumber" class="form-label"></label>
                            <input asp-for="NTNNumber" class="form-control" id="ntnInput" placeholder="0000000-0" maxlength="9" />
                            <span asp-validation-for="NTNNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalesTaxRegistrationNumber" class="form-label"></label>
                            <input asp-for="SalesTaxRegistrationNumber" class="form-control" id="strnInput" placeholder="00-00-0000-000-00" maxlength="19" />
                            <span asp-validation-for="SalesTaxRegistrationNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label"></label>
                            <select asp-for="Country" id="vendorCountrySelect" class="form-select" data-initial-value="@Model.Country"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <select asp-for="City" id="vendorCitySelect" class="form-select" data-initial-value="@Model.City"></select>
                            <div class="form-text">Pick a city or type your own if it's not listed.</div>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpeningBalance" class="form-label"></label>
                            <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="Vendors" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> @(isEdit ? "Update Vendor" : "Create Vendor")</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('ntnInput')?.addEventListener('input', function () {
            let digits = this.value.replace(/\D/g, '').slice(0, 8);
            this.value = digits.length > 7 ? digits.slice(0, 7) + '-' + digits.slice(7) : digits;
        });
        document.getElementById('strnInput')?.addEventListener('input', function () {
            let d = this.value.replace(/\D/g, '').slice(0, 13);
            let parts = [d.slice(0, 2), d.slice(2, 4), d.slice(4, 8), d.slice(8, 11), d.slice(11, 13)];
            this.value = parts.filter(p => p.length > 0).join('-');
        });
        initCountryCityCascade('vendorCountrySelect', 'vendorCitySelect');
    </script>
}
