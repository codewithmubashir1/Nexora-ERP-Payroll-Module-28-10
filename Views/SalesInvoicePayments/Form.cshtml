@model ERP.Identity.Models.ViewModels.Sales.SalesInvoicePaymentViewModel
@{
    ViewData["Title"] = "New Sales Invoice Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <form asp-controller="SalesInvoicePayments" asp-action="Save" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="card animate__animated animate__fadeIn">
                <div class="card-header"><h3 class="card-title">Payment Details</h3></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" id="customerSelect" class="form-select select2" data-placeholder="Select customer">
                                <option></option>
                                @foreach (var c in Model.Customers) { <option value="@c.Id">@c.Name (@c.CustomerCode)</option> }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="form-label"></label>
                            <input asp-for="PaymentDate" class="form-control datepicker" autocomplete="off" value="@Model.PaymentDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalesInvoiceId" class="form-label"></label>
                            <select asp-for="SalesInvoiceId" id="invoiceSelect" class="form-select select2" data-placeholder="Select an invoice with a balance">
                                <option></option>
                                @foreach (var i in Model.Invoices) { <option value="@i.Id" data-customer-id="@i.CustomerId" data-balance="@i.Balance.ToString("F2")">@i.InvoiceNumber (Balance: @i.Balance.ToString("N2"))</option> }
                            </select>
                            <span asp-validation-for="SalesInvoiceId" class="text-danger small"></span>
                            <div class="form-text">Selecting a customer narrows this list; selecting an invoice fills the customer and amount automatically.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" id="amountInput" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WithholdingTaxRate" class="form-label"></label>
                            <select asp-for="WithholdingTaxRate" id="whtSelect" class="form-select select2">
                                <option value="">No Withholding Tax</option>
                                @foreach (var rate in new[] { 0m, 0.5m, 1m, 1.5m, 2m, 2.5m, 3m, 3.5m, 4m, 4.5m, 5m, 5.5m })
                                {
                                    <option value="@rate.ToString(System.Globalization.CultureInfo.InvariantCulture)">@rate%</option>
                                }
                            </select>
                            <div class="form-text" id="netReceivedHint">If the customer withholds tax when paying us, select the rate here.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <select asp-for="PaymentMethod" id="paymentMethodSelect" class="form-select select2">
                                <option value="0">Cash</option>
                                <option value="1">Bank Transfer</option>
                                <option value="2">Cheque</option>
                            </select>
                        </div>
                        <div class="col-md-4" id="chequeNumberField" style="display:none;">
                            <label asp-for="ChequeNumber" class="form-label"></label>
                            <input asp-for="ChequeNumber" class="form-control" />
                        </div>
                        <div class="col-md-4" id="bankNameField" style="display:none;">
                            <label asp-for="BankName" class="form-label"></label>
                            <input asp-for="BankName" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label"></label>
                            <input asp-for="Remarks" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-controller="SalesInvoicePayments" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Submit for Approval</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleChequeFields() {
            const method = document.getElementById('paymentMethodSelect').value;
            const show = method === '2' ? 'block' : 'none';
            document.getElementById('chequeNumberField').style.display = show;
            document.getElementById('bankNameField').style.display = show;
        }

        // Live calculation: Net Received = Amount - (Amount x WHT% / 100) — shown
        // as a hint under the Withholding Tax dropdown. The invoice balance is
        // still reduced by the full Amount; this is just the actual cash/bank
        // /cheque received.
        function recalcNetReceived() {
            const amount = parseFloat(document.getElementById('amountInput').value) || 0;
            const whtPct = parseFloat(document.getElementById('whtSelect').value) || 0;
            const hint = document.getElementById('netReceivedHint');

            if (whtPct > 0 && amount > 0) {
                const whtAmount = amount * whtPct / 100;
                const net = amount - whtAmount;
                hint.textContent = `Withheld by customer: ${whtAmount.toFixed(2)} — Net received: ${net.toFixed(2)}`;
            } else {
                hint.textContent = 'If the customer withholds tax when paying us, select the rate here.';
            }
        }
        jQuery('#whtSelect').on('change', recalcNetReceived);
        document.getElementById('amountInput').addEventListener('input', recalcNetReceived);
        jQuery('#paymentMethodSelect').on('change', toggleChequeFields);
        toggleChequeFields();

        // Narrow the invoice dropdown to the selected customer's unpaid invoices.
        jQuery('#customerSelect').on('change', function () {
            const customerId = this.value;
            const invoiceSelect = jQuery('#invoiceSelect');
            invoiceSelect.empty().append('<option></option>');

            if (!customerId) { invoiceSelect.trigger('change'); return; }

            fetch(`/Sales/Payments/GetInvoicesForCustomer/${customerId}`)
                .then(r => r.json())
                .then(data => {
                    data.forEach(inv => {
                        invoiceSelect.append(`<option value="${inv.id}" data-customer-id="${inv.customerId}" data-balance="${Number(inv.balance).toFixed(2)}">${inv.invoiceNumber} (Balance: ${Number(inv.balance).toFixed(2)})</option>`);
                    });
                    invoiceSelect.trigger('change');
                })
                .catch(() => notyf.error('Could not load invoices for this customer.'));
        });

        // Selecting an invoice auto-populates the customer (if not already set)
        // and pre-fills the payment amount with that invoice's outstanding balance.
        jQuery('#invoiceSelect').on('change', function () {
            const selected = this.options[this.selectedIndex];
            if (!selected || !selected.value) return;

            const customerId = selected.getAttribute('data-customer-id');
            const balance = selected.getAttribute('data-balance');

            if (customerId && jQuery('#customerSelect').val() !== customerId) {
                jQuery('#customerSelect').val(customerId).trigger('change.select2');
            }
            if (balance) {
                document.querySelector('#amountInput').value = balance;
            }
        });
    </script>
}
